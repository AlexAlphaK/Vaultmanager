#: autoload/calendar.gd
msgid "%d more day"
msgid_plural "%d more days"
msgstr[0] "%d día más"
msgstr[1] "%d días más"

#: autoload/calendar.gd
msgid "%s (in %d days)"
msgstr "%s (en %d días)"

#: autoload/calendar.gd
msgid "%s is over. %s starts tomorrow."
msgstr "%s ha terminado. %s empieza mañana."

#: autoload/calendar.gd
msgid "%s is over. You served %d of its customers."
msgstr "%s ha terminado. Atendiste a %d de sus clientes."

#: autoload/calendar.gd
msgid "%s, day %d of %d"
msgstr "%s, día %d de %d"

#: autoload/calendar.gd
msgid "A silver coin for my nephew's stocking, please."
msgstr "Una moneda de plata para el calcetín de mi sobrino, por favor."

#: autoload/calendar.gd
msgid "Autumn"
msgstr "Otoño"

#: autoload/calendar.gd
msgid "COIN SHOW: collectors from three counties are in town for the weekend."
msgstr "FERIA NUMISMÁTICA: coleccionistas de tres condados pasan el fin de semana en el pueblo."

#: autoload/calendar.gd
msgid "Coin show booth"
msgstr "Puesto en la feria"

#: autoload/calendar.gd
msgid "Collectors pay well for exact coins and rare ones. A booth brings more of them."
msgstr "Los coleccionistas pagan bien por monedas concretas y raras. Un puesto atrae a más."

#: autoload/calendar.gd
msgid "Debug: skipped ahead to day %d, %s."
msgstr "Debug: saltado al día %d, %s."

#: autoload/calendar.gd
msgid "Everyone's paying up for gold this week. My turn."
msgstr "Esta semana todos pagan más por el oro. Me toca."

#: autoload/calendar.gd
msgid "GOLD FEVER: Prospector Days are on and the whole town wants gold."
msgstr "FIEBRE DEL ORO: llegan los Días del Buscador y todo el pueblo quiere oro."

#: autoload/calendar.gd
msgid "Gift buyers want small coins and pay a good premium. Keep the shelves full."
msgstr "Los compradores de regalos quieren monedas pequeñas y pagan buena prima. Llena los estantes."

#: autoload/calendar.gd
msgid "Gift-wrapped, if you can. It's for my mum."
msgstr "Envuelto para regalo, si puede. Es para mi madre."

#: autoload/calendar.gd
msgid "Gold buyers pay more all week. Stock up on gold coins."
msgstr "Los compradores de oro pagan más toda la semana. Abastécete de monedas de oro."

#: autoload/calendar.gd
msgid "Gold fever week"
msgstr "Semana de la fiebre del oro"

#: autoload/calendar.gd
msgid "Gold fever, they call it. I've caught it."
msgstr "Lo llaman fiebre del oro. Me ha pillado."

#: autoload/calendar.gd
msgid "HOLIDAY RUSH: shoppers want coins to give as gifts, and they pay for the wrapping."
msgstr "FIEBRE DE REGALOS: todos quieren monedas para regalar y pagan el envoltorio."

#: autoload/calendar.gd
msgid "Holiday gift rush"
msgstr "Fiebre de regalos"

#: autoload/calendar.gd
msgid "In town for the show. What have you got?"
msgstr "Vengo por la feria. ¿Qué tiene?"

#: autoload/calendar.gd
msgid "Last-minute present. You're a lifesaver."
msgstr "Regalo de última hora. Me salva la vida."

#: autoload/calendar.gd
msgid "My accountant says sell. So I'm selling."
msgstr "Mi gestor dice que venda. Así que vendo."

#: autoload/calendar.gd
msgid "Owe more than I thought this year. Cash, please."
msgstr "Debo más de lo que pensaba. En efectivo, por favor."

#: autoload/calendar.gd
msgid "Panned this lot at the festival. Well, my grandpa did."
msgstr "Esto lo saqué con la batea en la fiesta. Bueno, mi abuelo."

#: autoload/calendar.gd
msgid "Prospector Days! I want real gold, not the fudge kind."
msgstr "¡Días del Buscador! Quiero oro de verdad, no de chocolate."

#: autoload/calendar.gd
msgid "Saw the parade. Now I want a gold coin of my own."
msgstr "He visto el desfile. Ahora quiero mi propia moneda de oro."

#: autoload/calendar.gd
msgid "Sellers want cash for their tax bills. Keep cash in the safe."
msgstr "Los vendedores necesitan efectivo para sus impuestos. Guarda efectivo en la caja fuerte."

#: autoload/calendar.gd
msgid "Something gold for my wife. Not too big, I'm not made of money."
msgstr "Algo de oro para mi mujer. No muy grande, que no soy rico."

#: autoload/calendar.gd
msgid "Spring"
msgstr "Primavera"

#: autoload/calendar.gd
msgid "Summer"
msgstr "Verano"

#: autoload/calendar.gd
msgid "TAX SEASON: the town is selling metal to pay the taxman. Tax Day is {last}."
msgstr "TEMPORADA DE IMPUESTOS: el pueblo vende metal para pagar a Hacienda. El día de impuestos es {last}."

#: autoload/calendar.gd
msgid "Tax Day"
msgstr "Día de impuestos"

#: autoload/calendar.gd
msgid "Tax Day: no profit since the last one, so no tax to pay."
msgstr "Día de impuestos: sin beneficios desde el último, así que nada que pagar."

#: autoload/calendar.gd
msgid "Tax Day: you paid %s, %d%% of your %s profit (after costs) since the last one."
msgstr "Día de impuestos: pagaste %s, el %d%% de tus %s de beneficio (tras costes) desde el último."

#: autoload/calendar.gd
msgid "Tax season"
msgstr "Temporada de impuestos"

#: autoload/calendar.gd
msgid "The taxman wants his cut. These have to go."
msgstr "Hacienda quiere su parte. Estas tienen que irse."

#: autoload/calendar.gd
msgid "Tomorrow: %s. %s"
msgstr "Mañana: %s. %s"

#: autoload/calendar.gd
msgid "Town coin show"
msgstr "Feria numismática"

#: autoload/calendar.gd
msgid "Winter"
msgstr "Invierno"

#: autoload/calendar.gd
msgid "You booked a booth at the coin show. Collectors will find you."
msgstr "Reservaste un puesto en la feria. Los coleccionistas te encontrarán."

#: autoload/calendar.gd
msgid "collectors pay well."
msgstr "los coleccionistas pagan bien."

#: autoload/calendar.gd
msgid "gold buyers pay more."
msgstr "los compradores de oro pagan más."

#: autoload/calendar.gd
msgid "last day"
msgstr "último día"

#: autoload/calendar.gd
msgid "on %s"
msgstr "el %s"

#: autoload/calendar.gd
msgid "small gifts sell well."
msgstr "los regalos pequeños se venden bien."

#: autoload/calendar.gd
msgid "tax of about {tax} due {tax_day}."
msgstr "impuestos de unos {tax}, a pagar {tax_day}."

#: autoload/calendar.gd scenes/shop/day_panels.gd
msgid "today"
msgstr "hoy"

#: autoload/calendar.gd
msgid "tomorrow"
msgstr "mañana"

#: autoload/calendar.gd
msgid "tonight"
msgstr "esta noche"

#: autoload/customers.gd
msgid "%s coins for the collection. I pay for quality."
msgstr "Monedas %s para la colección. Pago por la calidad."

#: autoload/customers.gd
msgid "%s has found another shop."
msgstr "%s ha encontrado otra tienda."

#: autoload/customers.gd
msgid "%s is back."
msgstr "%s ha vuelto."

#: autoload/customers.gd
msgid "%s sold you fakes and walked off laughing."
msgstr "%s te vendió falsificaciones y se fue riendo."

#: autoload/customers.gd
msgid "%s walked in."
msgstr "%s ha entrado."

#: autoload/customers.gd
msgid "%s will come back when you have %s in stock."
msgstr "%s volverá cuando tengas %s en stock."

#: autoload/customers.gd
msgid "%s won't be coming back."
msgstr "%s no volverá."

#: autoload/customers.gd
msgid "%s%.1f stars"
msgstr "%s%.1f estrellas"

#: autoload/customers.gd
msgid "Ada Okafor"
msgstr "Ada Okafor"

#: autoload/customers.gd
msgid "Ada Okafor is your newest customer. Her grandma is very proud."
msgstr "Ada Okafor es tu clienta más nueva. Su abuela está muy orgullosa."

#: autoload/customers.gd
msgid "Ada got into the science programme! Ten more for the fund."
msgstr "¡Ada entró en el programa de ciencias! Diez más para el fondo."

#: autoload/customers.gd
msgid "Any %s coins? Nice strike, no spots, please."
msgstr "¿Tiene monedas %s? Buena acuñación y sin manchas, por favor."

#: autoload/customers.gd
msgid "Back from the dead! Diamond hands. Give me your shiniest."
msgstr "¡He resucitado! Manos de diamante. Dame lo más brillante."

#: autoload/customers.gd
msgid "Brayden"
msgstr "Brayden"

#: autoload/customers.gd
msgid "Britannias next. Three, for a display on the history of coinage."
msgstr "Ahora Britannias. Tres, para una exposición sobre la historia de la moneda."

#: autoload/customers.gd
msgid "Buying the crypto dip. Need cash for it, bro."
msgstr "Compro la caída del cripto. Necesito efectivo, bro."

#: autoload/customers.gd
msgid "Cash only. No paperwork. You understand."
msgstr "Solo efectivo. Sin papeles. Ya me entiende."

#: autoload/customers.gd
msgid "Chad"
msgstr "Chad"

#: autoload/customers.gd
msgid "Chad bought gold to 'diversify his bag'."
msgstr "Chad compró oro para \"diversificar su cartera\"."

#: autoload/customers.gd
msgid "Chad posted your shop to all his followers. 'Based gold guy.'"
msgstr "Chad publicó tu tienda para todos sus seguidores. \"El tío del oro, top.\""

#: autoload/customers.gd
msgid "Chad sold his gold back after a bad week in crypto."
msgstr "Chad revendió su oro tras una mala semana en cripto."

#: autoload/customers.gd
msgid "Detective Ruiz"
msgstr "Detective Ruiz"

#: autoload/customers.gd
msgid "Detective Ruiz paid you the reward for Vinnie's fakes."
msgstr "El detective Ruiz te pagó la recompensa por las falsificaciones de Vinnie."

#: autoload/customers.gd
msgid "Detective Ruiz warned you about buying from Vinnie."
msgstr "El detective Ruiz te advirtió de comprarle a Vinnie."

#: autoload/customers.gd
msgid "Diversifying my bag. Need gold, like, now."
msgstr "Diversifico la cartera. Necesito oro, tipo, ya."

#: autoload/customers.gd
msgid "Don't ask about my portfolio. Just buy these."
msgstr "No preguntes por mi cartera. Cómpralas y ya."

#: autoload/customers.gd
msgid "Dr. Vance is building a museum display on the history of coinage."
msgstr "La Dra. Vance prepara una exposición sobre la historia de la moneda."

#: autoload/customers.gd
msgid "Dr. Vance's display opens at the town museum next week."
msgstr "La exposición de la Dra. Vance abre la semana que viene en el museo."

#: autoload/customers.gd
msgid "Dr. Vance, a collector, added your Krugerrand to her cabinet."
msgstr "La Dra. Vance, coleccionista, añadió tu Krugerrand a su vitrina."

#: autoload/customers.gd
msgid "Everything's negotiable, friend."
msgstr "Todo es negociable, amigo."

#: autoload/customers.gd
msgid "Fresh from my uncle's estate. Very fresh. Cash, yeah?"
msgstr "Recién salidas de la herencia de mi tío. Muy recién. En efectivo, ¿vale?"

#: autoload/customers.gd
msgid "Gold's the OG blockchain, bro."
msgstr "El oro es la blockchain original, bro."

#: autoload/customers.gd
msgid "Got liquidated. Need those eagles turned back into fiat. Don't tell anyone."
msgstr "Me liquidaron. Hay que volver a pasar esas águilas a fiat. No se lo digas a nadie."

#: autoload/customers.gd
msgid "Got margin-called. Need fiat, fast."
msgstr "Me hicieron margin call. Necesito fiat, rápido."

#: autoload/customers.gd
msgid "Grandma's silver paid for my first year. Now I'm starting my own stack."
msgstr "La plata de la abuela pagó mi primer año. Ahora empiezo mi propio montón."

#: autoload/customers.gd
msgid "Grandpa Lev"
msgstr "Grandpa Lev"

#: autoload/customers.gd
msgid "Grandpa Lev sold you the first of his late wife's coins. He'll be back."
msgstr "Grandpa Lev te vendió las primeras monedas de su difunta esposa. Volverá."

#: autoload/customers.gd
msgid "Grandpa Lev sold you the last of Mira's coins. He looked lighter, somehow."
msgstr "Grandpa Lev te vendió las últimas monedas de Mira. Parecía más ligero, en cierto modo."

#: autoload/customers.gd
msgid "Grandpa Lev told the whole bowling league about your shop."
msgstr "Grandpa Lev le habló de tu tienda a toda la liga de bolos."

#: autoload/customers.gd
msgid "Grandpa Lev told you how Mira saved a coin from every trip they took."
msgstr "Grandpa Lev te contó que Mira guardaba una moneda de cada viaje."

#: autoload/customers.gd
msgid "Her favourite. I kept this one till last."
msgstr "Su favorita. Esta la guardé hasta el final."

#: autoload/customers.gd
msgid "I collect %s coins. Nothing else will do."
msgstr "Colecciono monedas %s. Nada más me sirve."

#: autoload/customers.gd
msgid "I collect Krugerrands. Do you have one with a crisp springbok?"
msgstr "Colecciono Krugerrands. ¿Tiene uno con un springbok bien nítido?"

#: autoload/customers.gd
msgid "I never pay sticker. Let's talk."
msgstr "Nunca pago el precio de etiqueta. Hablemos."

#: autoload/customers.gd
msgid "Jaxon"
msgstr "Jaxon"

#: autoload/customers.gd
msgid "Just took profits. Turn it into something shiny."
msgstr "Acabo de recoger beneficios. Conviértelos en algo brillante."

#: autoload/customers.gd
msgid "Last time, I promise. These ones are definitely real."
msgstr "La última vez, lo prometo. Estas son auténticas, seguro."

#: autoload/customers.gd
msgid "Last top-up before she goes. Ten more, and wish her luck."
msgstr "Última aportación antes de que se vaya. Diez más, y deséele suerte."

#: autoload/customers.gd
msgid "Let's not insult each other. What's your real number?"
msgstr "No nos insultemos. ¿Cuál es su precio real?"

#: autoload/customers.gd
msgid "Moonboy Mike"
msgstr "Moonboy Mike"

#: autoload/customers.gd
msgid "More of Mira's collection. She'd want it to go to someone honest."
msgstr "Más de la colección de Mira. Ella querría que fuera a alguien honrado."

#: autoload/customers.gd
msgid "Mrs. Okafor finished Ada's college fund."
msgstr "La Sra. Okafor completó el fondo universitario de Ada."

#: autoload/customers.gd
msgid "Mrs. Okafor started a college fund in silver for her granddaughter."
msgstr "La Sra. Okafor abrió un fondo universitario en plata para su nieta."

#: autoload/customers.gd
msgid "Mrs. Okafor's granddaughter got into the science programme."
msgstr "La nieta de la Sra. Okafor entró en el programa de ciencias."

#: autoload/customers.gd
msgid "My Mira bought one of these every birthday. Time to let a few go."
msgstr "Mi Mira compraba una de estas cada cumpleaños. Es hora de soltar algunas."

#: autoload/customers.gd
msgid "My cousin's coins. He's... away."
msgstr "Las monedas de mi primo. Está... fuera."

#: autoload/customers.gd
msgid "My grandson graduates Friday. I want to buy him a gold coin, and I want it from you."
msgstr "Mi nieto se gradúa el viernes. Quiero comprarle una moneda de oro, y quiero que sea suya."

#: autoload/customers.gd
msgid "My old teacher's eagles. I want them in good hands, not a fair price."
msgstr "Las águilas de mi viejo maestro. Las quiero en buenas manos, no a buen precio."

#: autoload/customers.gd
msgid "New batch. Same uncle. Different estate."
msgstr "Nuevo lote. Mismo tío. Otra herencia."

#: autoload/customers.gd
msgid "Priced to move. Don't ask where they're from."
msgstr "A precio de ganga. No preguntes de dónde salen."

#: autoload/customers.gd autoload/orders.gd
msgid "Professor Hale"
msgstr "Professor Hale"

#: autoload/customers.gd
msgid "Quick deal, yeah? I'm double parked."
msgstr "Trato rápido, ¿vale? Tengo el coche en doble fila."

#: autoload/customers.gd
msgid "Reward"
msgstr "Recompensa"

#: autoload/customers.gd autoload/story.gd
msgid "Reward: "
msgstr "Recompensa: "

#: autoload/customers.gd
msgid "Silver for my granddaughter Ada's college fund. Five, please."
msgstr "Plata para el fondo universitario de mi nieta Ada. Cinco, por favor."

#: autoload/customers.gd
msgid "Some Guy"
msgstr "Some Guy"

#: autoload/customers.gd
msgid "Tanner"
msgstr "Tanner"

#: autoload/customers.gd
msgid "The centrepiece: a platinum eagle. The museum opens next week."
msgstr "La pieza central: un águila de platino. El museo abre la semana que viene."

#: autoload/customers.gd
msgid "The museum display credits your shop. People are talking."
msgstr "La exposición del museo menciona tu tienda. La gente habla."

#: autoload/customers.gd
msgid "Took some profits, bro. Gold's the original blockchain."
msgstr "He recogido beneficios, bro. El oro es la blockchain original."

#: autoload/customers.gd
msgid "Two-Phones Tony"
msgstr "Two-Phones Tony"

#: autoload/customers.gd
msgid "Vinnie"
msgstr "Vinnie"

#: autoload/customers.gd
msgid "Vinnie's been passing fakes all over town. Some ended up in your vault. Test your coins."
msgstr "Vinnie ha colado falsificaciones por todo el pueblo. Algunas acabaron en tu cámara. Revisa tus monedas."

#: autoload/customers.gd
msgid "We picked up Vinnie's counterfeit ring. Your tips helped. The town's reward is yours."
msgstr "Desmantelamos la red de falsificación de Vinnie. Tus pistas ayudaron. La recompensa del pueblo es tuya."

#: autoload/customers.gd
msgid "You caught %s's %s fakes. He'll try again."
msgstr "Pillaste las falsificaciones de %s (%s). Lo volverá a intentar."

#: autoload/customers.gd
msgid "You caught %s's fakes again. Word is the police are interested."
msgstr "Volviste a pillar las falsificaciones de %s. Dicen que la policía está interesada."

#: autoload/customers.gd
msgid "collector"
msgstr "coleccionista"

#: autoload/customers.gd
msgid "crypto bro"
msgstr "cripto-bro"

#: autoload/customers.gd
msgid "haggler"
msgstr "regateador"

#: autoload/customers.gd
msgid "looks nervous"
msgstr "parece nervioso"

#: autoload/customers.gd
msgid "old coin"
msgstr "moneda antigua"

#: autoload/customers.gd
msgid "regular"
msgstr "habitual"

#: autoload/day.gd
msgid "Friday"
msgstr "Viernes"

#: autoload/day.gd
msgid "Insurance"
msgstr "Seguro"

#: autoload/day.gd
msgid "Monday"
msgstr "Lunes"

#: autoload/day.gd
msgid "Overdraft interest"
msgstr "Intereses de descubierto"

#: autoload/day.gd
msgid "Rent"
msgstr "Alquiler"

#: autoload/day.gd scenes/shop/rush_hours.gd
msgid "Saturday"
msgstr "Sábado"

#: autoload/day.gd
msgid "Sunday"
msgstr "Domingo"

#: autoload/day.gd
msgid "Thursday"
msgstr "Jueves"

#: autoload/day.gd
msgid "Tuesday"
msgstr "Martes"

#: autoload/day.gd
msgid "Upkeep"
msgstr "Mantenimiento"

#: autoload/day.gd
msgid "Wednesday"
msgstr "Miércoles"

#: autoload/day.gd
msgid "You are overdrawn. The bank charges interest every night."
msgstr "Estás en descubierto. El banco cobra intereses cada noche."

#: autoload/market_events.gd
msgid "BITCOIN CRASHES {move}. Burned crypto traders want something real."
msgstr "EL BITCOIN SE DESPLOMA {move}. Los traders quemados quieren algo real."

#: autoload/market_events.gd
msgid "BITCOIN SOARS {move}. Gold bugs sell up to chase crypto."
msgstr "EL BITCOIN SE DISPARA {move}. Los fans del oro venden para perseguir cripto."

#: autoload/market_events.gd
msgid "Buying the dip, like my dad taught me."
msgstr "Compro en la caída, como me enseñó mi padre."

#: autoload/market_events.gd
msgid "CHIP STOCKS PLUNGE: NVIDIA {move}. Tech money looks for shelter in silver."
msgstr "SE HUNDEN LOS CHIPS: NVIDIA {move}. El dinero tecnológico busca refugio en la plata."

#: autoload/market_events.gd
msgid "DOGECOIN MOONS {move}. Lucky winners want to lock in their gains in gold."
msgstr "DOGECOIN A LA LUNA {move}. Los afortunados quieren asegurar ganancias en oro."

#: autoload/market_events.gd
msgid "Dog money paid off. Turning it into real money."
msgstr "El dinero perruno ha dado frutos. Lo paso a dinero de verdad."

#: autoload/market_events.gd
msgid "Done with crypto. Give me something I can hold."
msgstr "Se acabó el cripto. Dame algo que pueda tocar."

#: autoload/market_events.gd
msgid "Forums say buy physical. How many do you have?"
msgstr "En los foros dicen que compres físico. ¿Cuántas tiene?"

#: autoload/market_events.gd
msgid "GOLD JUMPS {move}. Folks dig out old coins to cash in at the top."
msgstr "EL ORO SALTA {move}. La gente desempolva monedas viejas para vender en lo alto."

#: autoload/market_events.gd
msgid "GOLD SLIDES {move}. Panic sellers want out before it drops further."
msgstr "EL ORO CAE {move}. Los vendedores en pánico quieren salir antes de que baje más."

#: autoload/market_events.gd
msgid "Gold's boring. Selling to buy tech."
msgstr "El oro es aburrido. Vendo para comprar tecnológicas."

#: autoload/market_events.gd
msgid "Gold's crashing! Take them before they're worth nothing."
msgstr "¡El oro se hunde! Quédeselas antes de que no valgan nada."

#: autoload/market_events.gd
msgid "Gold's up again. Time to cash in."
msgstr "El oro sube otra vez. Hora de cobrar."

#: autoload/market_events.gd
msgid "Heard spot is flying today. What'll you give me?"
msgstr "Dicen que el spot vuela hoy. ¿Cuánto me da?"

#: autoload/market_events.gd
msgid "Lost a month's pay on chips today. Silver, please."
msgstr "Hoy perdí un mes de sueldo en chips. Plata, por favor."

#: autoload/market_events.gd
msgid "Much profit. Very gold. Wow."
msgstr "Mucho beneficio. Muy oro. Guau."

#: autoload/market_events.gd
msgid "My broker isn't picking up. You'll buy these, right?"
msgstr "Mi bróker no contesta. Me las compra, ¿verdad?"

#: autoload/market_events.gd
msgid "My coins halved overnight. Gold doesn't do that, right?"
msgstr "Mis monedas se han quedado en la mitad en una noche. El oro no hace eso, ¿no?"

#: autoload/market_events.gd
msgid "My nephew says gold is a boomer rock. Buy these?"
msgstr "Mi sobrino dice que el oro es una piedra de boomers. ¿Me las compra?"

#: autoload/market_events.gd
msgid "My retirement account is red. Something safe, please."
msgstr "Mi plan de pensiones está en rojo. Algo seguro, por favor."

#: autoload/market_events.gd
msgid "NEWS: "
msgstr "NOTICIAS: "

#: autoload/market_events.gd
msgid "Need cash fast, Bitcoin's taking off without me."
msgstr "Necesito efectivo ya, el Bitcoin despega sin mí."

#: autoload/market_events.gd
msgid "PLATINUM POPS {move}. Owners rush to sell."
msgstr "EL PLATINO SE DISPARA {move}. Los dueños corren a vender."

#: autoload/market_events.gd
msgid "Platinum's finally moving. Selling while it lasts."
msgstr "El platino por fin se mueve. Vendo mientras dure."

#: autoload/market_events.gd
msgid "SILVER ON SALE: SILVER {move}. Bargain hunters line up."
msgstr "PLATA DE OFERTA: PLATA {move}. Los cazagangas hacen cola."

#: autoload/market_events.gd
msgid "SILVER SQUEEZE: SILVER {move}. Stackers storm the shops."
msgstr "ESTRUJÓN DE LA PLATA: PLATA {move}. Los acumuladores asaltan las tiendas."

#: autoload/market_events.gd
msgid "STOCKS RALLY: S&P 500 {move}. Metal holders sell to buy shares."
msgstr "LA BOLSA SUBE: S&P 500 {move}. Quien tiene metal vende para comprar acciones."

#: autoload/market_events.gd
msgid "STOCKS TUMBLE: S&P 500 {move}. Investors run to safe-haven gold."
msgstr "LA BOLSA SE DESPLOMA: S&P 500 {move}. Los inversores huyen al oro refugio."

#: autoload/market_events.gd
msgid "Saw it on the news. I'm getting out now."
msgstr "Lo he visto en las noticias. Me salgo ya."

#: autoload/market_events.gd
msgid "Silver's going to the moon. I need tubes, now."
msgstr "La plata se va a la luna. Necesito tubos, ya."

#: autoload/market_events.gd
msgid "Silver's on sale. I'll take some."
msgstr "La plata está de oferta. Me llevo unas cuantas."

#: autoload/market_events.gd
msgid "Sold my Bitcoin at the bottom. Never again."
msgstr "Vendí mis Bitcoin en el fondo. Nunca más."

#: autoload/market_events.gd
msgid "Stocks are flying. Moving my stack into the market."
