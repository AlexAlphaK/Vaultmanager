msgstr "%s · guardado %s"

#: ui/save_slots_panel.gd
msgid "Delete"
msgstr "Borrar"

#: ui/save_slots_panel.gd
msgid "Each slot saves every morning and every night."
msgstr "Cada ranura se guarda cada mañana y cada noche."

#: ui/save_slots_panel.gd
