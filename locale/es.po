#: scenes/trading_desk/trading_desk.gd
msgid "Desk made %s today, after %s in fees."
msgstr "La mesa ganó %s hoy, tras %s en comisiones."

#: scenes/trading_desk/trading_desk.gd
msgid "Desk profit"
msgstr "Beneficio de la mesa"

#: scenes/trading_desk/trading_desk.gd
msgid "Each tape replays a day that ends near today's live price, so the real 24h move is your edge. Hedge vault protects your stock if metals fall."
msgstr "Cada cinta repite un día que termina cerca del precio real de hoy, así que el movimiento real de 24 h es tu ventaja. Cubrir la cámara protege tu stock si bajan los metales."

#: scenes/trading_desk/trading_desk.gd
msgid "Esc leaves without trading."
msgstr "Esc sale sin operar."

#: scenes/trading_desk/trading_desk.gd
msgid "Hedge vault (H)"
msgstr "Cubrir cámara (H)"

#: scenes/trading_desk/trading_desk.gd
msgid "Its profit"
msgstr "Su beneficio"

#: scenes/trading_desk/trading_desk.gd
msgid "LT"
msgstr "LT"

#: scenes/trading_desk/trading_desk.gd
msgid "Lifetime at the desk: %s."
msgstr "Total en la mesa: %s."

#: scenes/trading_desk/trading_desk.gd
msgid "Market"
msgstr "Mercado"

#: scenes/trading_desk/trading_desk.gd
msgid "Morning session"
msgstr "Sesión de mañana"

#: scenes/trading_desk/trading_desk.gd
msgid "No metal in the vault to hedge."
msgstr "No hay metal en la cámara que cubrir."

#: scenes/trading_desk/trading_desk.gd
msgid "Offline: the tapes are simulated."
msgstr "Sin conexión: las cintas son simuladas."

#: scenes/trading_desk/trading_desk.gd
msgid "On today's tape your vault gained %s on paper."
msgstr "En la cinta de hoy tu cámara ganó %s sobre el papel."

#: scenes/trading_desk/trading_desk.gd
msgid "On today's tape your vault lost %s on paper."
msgstr "En la cinta de hoy tu cámara perdió %s sobre el papel."

#: scenes/trading_desk/trading_desk.gd
msgid "POSITION"
msgstr "POSICIÓN"

#: scenes/trading_desk/trading_desk.gd
msgid "PRICE"
msgstr "PRECIO"

#: scenes/trading_desk/trading_desk.gd
msgid "Position"
msgstr "Posición"

#: scenes/trading_desk/trading_desk.gd
msgid "Pre-market"
msgstr "Preapertura"

#: scenes/trading_desk/trading_desk.gd
msgid "Previous / next row"
msgstr "Fila anterior / siguiente"

#: scenes/trading_desk/trading_desk.gd
msgid "RT"
msgstr "RT"

#: scenes/trading_desk/trading_desk.gd
msgid "Ring the opening bell"
msgstr "Tocar la campana"

#: scenes/trading_desk/trading_desk.gd
msgid "Short the gold, silver and platinum in your vault, ounce for ounce, with up to half the desk's limit."
msgstr "Ponte corto en el oro, la plata y el platino de tu cámara, onza a onza, con hasta la mitad del límite."

#: scenes/trading_desk/trading_desk.gd
msgid "Shorted the vault's metal with up to half the desk's limit."
msgstr "Te pusiste corto en el metal de la cámara con hasta la mitad del límite."

#: scenes/trading_desk/trading_desk.gd
msgid "TODAY"
msgstr "HOY"

#: scenes/trading_desk/trading_desk.gd
msgid "TRADING DESK"
msgstr "MESA DE TRADING"

#: scenes/trading_desk/trading_desk.gd
msgid "Together"
msgstr "Juntos"

#: scenes/trading_desk/trading_desk.gd
msgid "Trade %d%% of the desk's limit per click."
msgstr "Opera el %d%% del límite por clic."

#: scenes/trading_desk/trading_desk.gd
msgid "Vault on paper"
msgstr "Cámara sobre el papel"

#: scenes/trading_desk/trading_desk.gd
msgid "You watched the tape all day without a trade."
msgstr "Miraste la cinta todo el día sin operar."

#: scenes/trading_desk/trading_desk.gd
msgid "Your hedge offset %d%% of the vault's move."
msgstr "Tu cobertura compensó el %d%% del movimiento de la cámara."

#: scenes/trading_desk/trading_desk.gd
msgid "long "
msgstr "largo "

#: scenes/trading_desk/trading_desk.gd
msgid "short "
msgstr "corto "

#: scenes/tutorial/coach.gd
msgid "A customer"
msgstr "Un cliente"

#: scenes/tutorial/coach.gd
msgid "Are you sure?"
msgstr "¿Seguro?"

#: scenes/tutorial/coach.gd
msgid "Bar test"
msgstr "Prueba de lingote"

#: scenes/tutorial/coach.gd
msgid "Bills come out each night, and the day's numbers land here. Tomorrow morning, spend your profit on upgrades and keep an eye on the ticker. Good luck!"
msgstr "Las facturas se pagan cada noche y las cifras del día aparecen aquí. Mañana por la mañana invierte tus beneficios en mejoras y vigila el ticker. ¡Suerte!"

#: scenes/tutorial/coach.gd
msgid "Bought!"
msgstr "¡Comprado!"

#: scenes/tutorial/coach.gd
msgid "Burglars take whatever's left on the tray. Drag your stock into the safes: the floor safe never gets cracked, the wall safe sometimes does. Right-click turns a piece. The longer the lights stay on, the riskier it gets, so be quick."
msgstr "Los ladrones se llevan lo que quede en la bandeja. Arrastra tu stock a las cajas fuertes: la del suelo nunca se revienta, la de pared a veces. Clic derecho gira una pieza. Cuanto más tiempo sigan las luces encendidas, más riesgo, así que date prisa."

#: scenes/tutorial/coach.gd
msgid "Catching fakes earns reputation. Fakes you buy cost you the money and your stars when the assay lab checks them."
msgstr "Pillar falsificaciones da reputación. Las que compras te cuestan el dinero y estrellas cuando el laboratorio las revisa."

#: scenes/tutorial/coach.gd
msgid "Caught in the act"
msgstr "Pillado in fraganti"

#: scenes/tutorial/coach.gd
msgid "Caught!"
msgstr "¡Pillado!"

#: scenes/tutorial/coach.gd
msgid "Day one done"
msgstr "Primer día hecho"

#: scenes/tutorial/coach.gd
msgid "Each tool checks one thing. Press 1 for the Scale and 2 for the Calipers, then compare each READING with the SPEC next to it."
msgstr "Cada herramienta mide una cosa. Pulsa 1 para la Báscula y 2 para el Calibre, y compara cada LECTURA con la FICHA de al lado."

#: scenes/tutorial/coach.gd
msgid "Five silver coins, please. A birthday present."
msgstr "Cinco monedas de plata, por favor. Es un regalo de cumpleaños."

#: scenes/tutorial/coach.gd
msgid "Got it"
msgstr "Entendido"

#: scenes/tutorial/coach.gd
msgid "Here comes someone else. Keep an eye on this one."
msgstr "Viene alguien más. Vigila a este."

#: scenes/tutorial/coach.gd
msgid "Jewellery appraisal"
msgstr "Tasación de joyas"

#: scenes/tutorial/coach.gd
msgid "June left without selling. That's fine; there's always another customer."
msgstr "June se fue sin vender. No pasa nada, siempre llega otro cliente."

#: scenes/tutorial/coach.gd
msgid "June wants to sell %d Silver Eagles. Melt today is what the silver in them is worth. Your offer is what you'd pay. Never buy coins untested: press Test coin."
msgstr "June quiere vender %d Silver Eagles. Fundición hoy es lo que vale su plata. Tu oferta es lo que pagarías. Nunca compres monedas sin probar: pulsa Probar."

#: scenes/tutorial/coach.gd
msgid "June's coins are in your vault now. You can see them under IN THE VAULT."
msgstr "Las monedas de June ya están en tu cámara. Las ves en EN LA CÁMARA."

#: scenes/tutorial/coach.gd
msgid "Live prices"
msgstr "Precios en directo"

#: scenes/tutorial/coach.gd
msgid "Lock up"
msgstr "Cerrar"

#: scenes/tutorial/coach.gd
msgid "Make an offer"
msgstr "Hacer una oferta"

#: scenes/tutorial/coach.gd
msgid "My dad's old Silver Eagles. I'd like a fair price."
msgstr "Las viejas Silver Eagles de mi padre. Quiero un precio justo."

#: scenes/tutorial/coach.gd
msgid "Next"
msgstr "Siguiente"

#: scenes/tutorial/coach.gd
msgid "No deal"
msgstr "Sin trato"

#: scenes/tutorial/coach.gd
msgid "Now you're on your own. Customers keep coming until 17:00, then you lock up the vault. Jewellery and bars have their own benches; you'll get a quick intro to each the first time."
msgstr "Ahora estás solo. Los clientes vienen hasta las 17:00 y luego cierras la cámara. Las joyas y los lingotes tienen sus propias mesas; la primera vez verás una breve introducción."

#: scenes/tutorial/coach.gd
msgid "One more. This one wants to buy."
msgstr "Uno más. Este quiere comprar."

#: scenes/tutorial/coach.gd
msgid "Open up"
msgstr "Abrir"

#: scenes/tutorial/coach.gd
msgid "Played it safe"
msgstr "Jugaste seguro"

#: scenes/tutorial/coach.gd
msgid "Press Open the shop when you're ready."
msgstr "Pulsa Abrir la tienda cuando estés listo."

#: scenes/tutorial/coach.gd
msgid "Priya wants 5 silver coins from your vault. She pays melt plus your premium. Press Sell."
msgstr "Priya quiere 5 monedas de plata de tu cámara. Paga la fundición más tu prima. Pulsa Vender."

#: scenes/tutorial/coach.gd
msgid "Read the bench"
msgstr "Lee la mesa"

#: scenes/tutorial/coach.gd
msgid "Real coins. Press Make offer to buy them at your price."
msgstr "Monedas auténticas. Pulsa Ofrecer para comprarlas a tu precio."

#: scenes/tutorial/coach.gd
msgid "Real silver only drags a little. This coin snapped to the magnet: it's plated steel. Press Fake."
msgstr "La plata auténtica solo se arrastra un poco. Esta moneda se pegó al imán: es acero chapado. Pulsa Falso."

#: scenes/tutorial/coach.gd
msgid "Selling"
msgstr "Vender"

#: scenes/tutorial/coach.gd
msgid "Show me"
msgstr "Enséñamelo"

#: scenes/tutorial/coach.gd
msgid "Silver Eagles, cheap. Cash only, no questions, yeah?"
msgstr "Silver Eagles, baratas. Solo efectivo, sin preguntas, ¿vale?"

#: scenes/tutorial/coach.gd
msgid "Skip tutorial"
msgstr "Saltar tutorial"

#: scenes/tutorial/coach.gd
msgid "Slick's in a hurry and won't haggle. Cheap coins from a nervous seller are often fake. Test them too."
msgstr "Slick tiene prisa y no regatea. Las monedas baratas de un vendedor nervioso suelen ser falsas. Pruébalas también."

#: scenes/tutorial/coach.gd
msgid "Sold!"
msgstr "¡Vendido!"

#: scenes/tutorial/coach.gd
msgid "Start the clock"
msgstr "Poner el reloj en marcha"

#: scenes/tutorial/coach.gd
msgid "Steel fakes give themselves away to a magnet. Press 4."
msgstr "Las falsificaciones de acero se delatan con el imán. Pulsa 4."

#: scenes/tutorial/coach.gd
msgid "That's the counter"
msgstr "Este es el mostrador"

#: scenes/tutorial/coach.gd
msgid "The coin test"
msgstr "La prueba de moneda"

#: scenes/tutorial/coach.gd
msgid "The magnet"
msgstr "El imán"

#: scenes/tutorial/coach.gd
msgid "The ticker shows today's spot prices from the real market. Every coin's value follows them, so the same coin is worth more on some days than others."
msgstr "El ticker muestra los precios spot de hoy del mercado real. El valor de cada moneda los sigue, así que la misma moneda vale más unos días que otros."

#: scenes/tutorial/coach.gd
msgid "Those coins snapped to the magnet. You can still press Refuse."
msgstr "Esas monedas se pegaron al imán. Aún puedes pulsar Rechazar."

#: scenes/tutorial/coach.gd
msgid "Those were plated steel. The assay lab will catch them soon and you'll lose what you paid. Always test first."
msgstr "Era acero chapado. El laboratorio lo detectará pronto y perderás lo que pagaste. Prueba siempre primero."

#: scenes/tutorial/coach.gd
msgid "Too good to be true?"
msgstr "¿Demasiado bueno para ser verdad?"

#: scenes/tutorial/coach.gd
msgid "Tungsten weighs almost the same as gold, so the scale isn't enough. Press 3 and sweep the ultrasound probe over the whole bar: the echo must stay inside the gate, and an early echo means tungsten inside. Read the serial under the loupe; a copied serial gets flagged. The XRF gun comes as an upgrade."
msgstr "El tungsteno pesa casi lo mismo que el oro, así que la báscula no basta. Pulsa 3 y pasa la sonda de ultrasonidos por todo el lingote: el eco debe quedarse en la ventana, y un eco temprano significa tungsteno dentro. Lee el número de serie con la lupa; uno copiado queda marcado. La pistola XRF llega como mejora."

#: scenes/tutorial/coach.gd
msgid "Turning away untested coins is safe. Testing them proves it, and catching a fake earns reputation."
msgstr "Rechazar monedas sin probar es seguro. Probarlas lo demuestra, y pillar una falsificación da reputación."

#: scenes/tutorial/coach.gd
msgid "Tutorial skipped. Good luck!"
msgstr "Tutorial saltado. ¡Suerte!"

#: scenes/tutorial/coach.gd
msgid "Uh oh"
msgstr "Uy"

#: scenes/tutorial/coach.gd
msgid "Weigh the piece. Then press 2 to rub a streak on the touchstone and drop acids on it (Q-Y): the streak survives acids up to its karat, and base metal fizzes. The Tester checks a stone; moissanite fools it, so look for doubled facet edges under the loupe. Set the grade (G) and the stone (D), then Finish appraisal."
msgstr "Pesa la pieza. Luego pulsa 2 para frotar una raya en la piedra de toque y echar ácidos (Q-Y): la raya resiste los ácidos hasta su quilataje y el metal base burbujea. El probador revisa la piedra; la moissanita lo engaña, así que busca aristas de faceta dobles con la lupa. Elige la ley (G) y la piedra (D) y pulsa Terminar tasación."

#: scenes/tutorial/coach.gd
msgid "Weight, diameter and thickness all match the spec. This is a real Silver Eagle. Press Genuine."
msgstr "Peso, diámetro y grosor coinciden con la ficha. Es una Silver Eagle auténtica. Pulsa Auténtico."

#: scenes/tutorial/coach.gd
msgid "Welcome to your shop"
msgstr "Bienvenido a tu tienda"

#: scenes/tutorial/coach.gd
msgid "You buy and sell gold, silver and platinum at real market prices. Your goal: the biggest store in town. Let's serve your first customers together."
msgstr "Compras y vendes oro, plata y platino a precios reales de mercado. Tu meta: la tienda más grande del pueblo. Atendamos juntos a tus primeros clientes."

#: scenes/tutorial/coach.gd
msgid "You pay sellers a little under melt and charge buyers a little over it. That gap is your profit. The -/+ buttons change both, but push too far and customers walk."
msgstr "Pagas a los vendedores un poco menos que la fundición y cobras a los compradores un poco más. Esa diferencia es tu beneficio. Los botones -/+ cambian ambas, pero si te pasas los clientes se van."

#: scenes/tutorial/coach.gd
msgid "Your first customer"
msgstr "Tu primer cliente"

#: scenes/tutorial/coach.gd
msgid "Your first customer is walking up to the counter."
msgstr "Tu primer cliente se acerca al mostrador."

#: scenes/tutorial/coach.gd
msgid "Your margins"
msgstr "Tus márgenes"

#: scenes/vault/vault.gd
msgid "Alarm: -%d%% risk"
msgstr "Alarma: -%d%% riesgo"

#: scenes/vault/vault.gd
msgid "Break-in overnight! Lost %s."
msgstr "¡Robo nocturno! Perdiste %s."

#: scenes/vault/vault.gd
msgid "Break-in risk"
msgstr "Riesgo de robo"

#: scenes/vault/vault.gd
msgid "Break-in risk was %d%%, with %d%% of the value locked away."
msgstr "El riesgo de robo era del %d%%, con el %d%% del valor bajo llave."

#: scenes/vault/vault.gd
msgid "Break-in: %s!"
msgstr "¡Robo: %s!"

#: scenes/vault/vault.gd
msgid "Burglars can't crack it"
msgstr "Los ladrones no pueden con ella"

#: scenes/vault/vault.gd
msgid "Closing time"
msgstr "Hora de cerrar"

#: scenes/vault/vault.gd
msgid "Cracked the wall safe: %s."
msgstr "Reventaron la caja de pared: %s."

#: scenes/vault/vault.gd
msgid "Crews crack it %d%% of the time"
msgstr "Las bandas la revientan el %d%% de las veces"

#: scenes/vault/vault.gd
msgid "Crews crack it %d%%, pros %d%%"
msgstr "Bandas %d%%, profesionales %d%%"

#: scenes/vault/vault.gd
msgid "Drag stock into the safes. Right-click or R turns a piece. What's left on the tray is easy pickings, and the longer the lights stay on, the likelier a break-in."
msgstr "Arrastra el stock a las cajas fuertes. Clic derecho o R gira una pieza. Lo que quede en la bandeja es presa fácil, y cuanto más sigan las luces, más probable un robo."

#: scenes/vault/vault.gd
msgid "Enter locks up. At zero it locks itself."
msgstr "Intro cierra. A cero se cierra sola."

#: scenes/vault/vault.gd
msgid "FLOOR SAFE"
msgstr "CAJA DE SUELO"

#: scenes/vault/vault.gd
msgid "Grabbed the best of the counter tray: %s. They left the rest."
msgstr "Se llevaron lo mejor de la bandeja: %s. Dejaron el resto."

#: scenes/vault/vault.gd
msgid "Insurance pays back %s."
msgstr "El seguro devuelve %s."

#: scenes/vault/vault.gd
msgid "Left on the tray"
msgstr "En la bandeja"

#: scenes/vault/vault.gd
msgid "Lights out in"
msgstr "Luces fuera en"

#: scenes/vault/vault.gd
msgid "Lock up now"
msgstr "Cerrar ya"

#: scenes/vault/vault.gd
msgid "Locked away"
msgstr "Bajo llave"

#: scenes/vault/vault.gd
msgid "Nobody came, and everything was locked away."
msgstr "No vino nadie y todo estaba bajo llave."

#: scenes/vault/vault.gd
msgid "Nobody came. Lucky: %s sat out on the counter all night."
msgstr "No vino nadie. Suerte: %s pasó la noche en el mostrador."

#: scenes/vault/vault.gd
msgid "Quiet night"
msgstr "Noche tranquila"

#: scenes/vault/vault.gd
msgid "Quiet night. The vault was untouched."
msgstr "Noche tranquila. Nadie tocó la cámara."

#: scenes/vault/vault.gd
msgid "See the day's results"
msgstr "Ver los resultados del día"

#: scenes/vault/vault.gd
msgid "The cameras caught them. Police got back %s."
msgstr "Las cámaras los grabaron. La policía recuperó %s."

#: scenes/vault/vault.gd
msgid "The customer ledger is gone. Reputation -%.1f."
msgstr "El registro de clientes ha desaparecido. Reputación -%.1f."

#: scenes/vault/vault.gd
msgid "The floor safe held."
msgstr "La caja de suelo aguantó."

#: scenes/vault/vault.gd
msgid "They couldn't crack the wall safe."
msgstr "No pudieron con la caja de pared."

#: scenes/vault/vault.gd
msgid "They never touched the safes."
msgstr "No tocaron las cajas fuertes."

#: scenes/vault/vault.gd
msgid "Took everything on the counter tray: %s."
msgstr "Se llevaron todo lo de la bandeja: %s."

#: scenes/vault/vault.gd
msgid "Total lost: %s."
msgstr "Pérdida total: %s."

#: scenes/vault/vault.gd
msgid "VAULT LOCK-UP"
msgstr "CIERRE DE LA CÁMARA"

#: scenes/vault/vault.gd
msgid "WALL SAFE"
msgstr "CAJA DE PARED"

#: scenes/vault/vault.gd
msgid "Worth %s today"
msgstr "Vale %s hoy"

#: scenes/vault/vault.gd
msgid "and more"
msgstr "y más"

#: scenes/vault/vault_layout.gd
msgid "%s in notes"
msgstr "%s en billetes"

#: scenes/vault/vault_layout.gd
msgid "Cash straps"
msgstr "Fajos de billetes"

#: scenes/vault/vault_layout.gd
msgid "Counter tray"
msgstr "Bandeja del mostrador"

#: scenes/vault/vault_layout.gd
msgid "Customer ledger"
msgstr "Registro de clientes"

#: scenes/vault/vault_layout.gd
msgid "Floor safe"
msgstr "Caja de suelo"

#: scenes/vault/vault_layout.gd
msgid "Gold coin box"
msgstr "Caja de monedas de oro"

#: scenes/vault/vault_layout.gd
msgid "Insurance payout"
msgstr "Pago del seguro"

#: scenes/vault/vault_layout.gd
msgid "Lose it: -%.1f reputation"
msgstr "Si se pierde: -%.1f reputación"

#: scenes/vault/vault_layout.gd
msgid "Monster box"
msgstr "Caja monstruo"

#: scenes/vault/vault_layout.gd
msgid "Names and addresses."
msgstr "Nombres y direcciones."

#: scenes/vault/vault_layout.gd
msgid "Platinum box"
msgstr "Caja de platino"

#: scenes/vault/vault_layout.gd
msgid "Silver tube"
msgstr "Tubo de plata"

#: scenes/vault/vault_layout.gd
msgid "Wall safe"
msgstr "Caja de pared"

