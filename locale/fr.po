#: autoload/calendar.gd
msgid "%s (in %d days)"
msgstr "%s (dans %d jours)"

#: autoload/calendar.gd
msgid "%s is over. %s starts tomorrow."
msgstr "%s est terminé. %s commence demain."

#: autoload/calendar.gd
msgid "%s is over. You served %d of its customers."
msgstr "%s est terminé. Vous avez servi %d de ses clients."

#: autoload/calendar.gd
msgid "%s, day %d of %d"
msgstr "%s, jour %d sur %d"

#: autoload/calendar.gd
msgid "A silver coin for my nephew's stocking, please."
msgstr "Une pièce d'argent pour le chausson de mon neveu, s'il vous plaît."

#: autoload/calendar.gd
msgid "Autumn"
msgstr "Automne"

#: autoload/calendar.gd
msgid "COIN SHOW: collectors from three counties are in town for the weekend."
msgstr "SALON NUMISMATIQUE : des collectionneurs de trois comtés sont en ville pour le week-end."

#: autoload/calendar.gd
msgid "Coin show booth"
msgstr "Stand au salon"

#: autoload/calendar.gd
msgid "Collectors pay well for exact coins and rare ones. A booth brings more of them."
msgstr "Les collectionneurs paient bien les pièces précises et rares. Un stand en attire davantage."

#: autoload/calendar.gd
msgid "Debug: skipped ahead to day %d, %s."
msgstr "Debug : saut au jour %d, %s."

#: autoload/calendar.gd
msgid "Everyone's paying up for gold this week. My turn."
msgstr "Tout le monde paie l'or plus cher cette semaine. À mon tour."

#: autoload/calendar.gd
msgid "GOLD FEVER: Prospector Days are on and the whole town wants gold."
msgstr "FIÈVRE DE L'OR : c'est la fête des prospecteurs et toute la ville veut de l'or."

#: autoload/calendar.gd
msgid "Gift buyers want small coins and pay a good premium. Keep the shelves full."
msgstr "Les acheteurs de cadeaux veulent de petites pièces et paient bien. Gardez les rayons pleins."

#: autoload/calendar.gd
msgid "Gift-wrapped, if you can. It's for my mum."
msgstr "En papier cadeau, si possible. C'est pour ma mère."

#: autoload/calendar.gd
msgid "Gold buyers pay more all week. Stock up on gold coins."
msgstr "Les acheteurs d'or paient plus toute la semaine. Faites le plein de pièces d'or."

#: autoload/calendar.gd
msgid "Gold fever week"
msgstr "Semaine de la fièvre de l'or"

#: autoload/calendar.gd
msgid "Gold fever, they call it. I've caught it."
msgstr "La fièvre de l'or, qu'ils disent. Je l'ai attrapée."

#: autoload/calendar.gd
msgid "HOLIDAY RUSH: shoppers want coins to give as gifts, and they pay for the wrapping."
msgstr "RUÉE DES FÊTES : on veut des pièces à offrir, et on paie l'emballage."

#: autoload/calendar.gd
msgid "Holiday gift rush"
msgstr "Ruée des fêtes"

#: autoload/calendar.gd
msgid "In town for the show. What have you got?"
msgstr "Je suis là pour le salon. Qu'avez-vous ?"

#: autoload/calendar.gd
msgid "Last-minute present. You're a lifesaver."
msgstr "Cadeau de dernière minute. Vous me sauvez."

#: autoload/calendar.gd
msgid "My accountant says sell. So I'm selling."
msgstr "Mon comptable dit de vendre. Alors je vends."

#: autoload/calendar.gd
msgid "Owe more than I thought this year. Cash, please."
msgstr "Je dois plus que prévu cette année. En liquide, svp."

#: autoload/calendar.gd
msgid "Panned this lot at the festival. Well, my grandpa did."
msgstr "J'ai trouvé ça à l'orpaillage de la fête. Enfin, mon grand-père."

#: autoload/calendar.gd
msgid "Prospector Days! I want real gold, not the fudge kind."
msgstr "Fête des prospecteurs ! Je veux du vrai or, pas en chocolat."

#: autoload/calendar.gd
msgid "Saw the parade. Now I want a gold coin of my own."
msgstr "J'ai vu le défilé. Maintenant je veux ma pièce d'or."

#: autoload/calendar.gd
msgid "Sellers want cash for their tax bills. Keep cash in the safe."
msgstr "Les vendeurs veulent du liquide pour leurs impôts. Gardez du liquide au coffre."

#: autoload/calendar.gd
msgid "Something gold for my wife. Not too big, I'm not made of money."
msgstr "Quelque chose en or pour ma femme. Pas trop gros, je ne suis pas millionnaire."

#: autoload/calendar.gd
msgid "Spring"
msgstr "Printemps"

#: autoload/calendar.gd
msgid "Summer"
msgstr "Été"

#: autoload/calendar.gd
msgid "TAX SEASON: the town is selling metal to pay the taxman. Tax Day is {last}."
msgstr "SAISON DES IMPÔTS : la ville vend du métal pour payer le fisc. Le jour des impôts est {last}."

#: autoload/calendar.gd
msgid "Tax Day"
msgstr "Jour des impôts"

#: autoload/calendar.gd
msgid "Tax Day: no profit since the last one, so no tax to pay."
msgstr "Jour des impôts : aucun bénéfice depuis le dernier, donc rien à payer."

#: autoload/calendar.gd
msgid "Tax Day: you paid %s, %d%% of your %s profit (after costs) since the last one."
msgstr "Jour des impôts : vous avez payé %s, soit %d%% de vos %s de bénéfice (après frais) depuis le dernier."

#: autoload/calendar.gd
msgid "Tax season"
msgstr "Saison des impôts"

#: autoload/calendar.gd
msgid "The taxman wants his cut. These have to go."
msgstr "Le fisc veut sa part. Celles-ci doivent partir."

#: autoload/calendar.gd
msgid "Tomorrow: %s. %s"
msgstr "Demain : %s. %s"

#: autoload/calendar.gd
msgid "Town coin show"
msgstr "Salon numismatique"

#: autoload/calendar.gd
msgid "Winter"
msgstr "Hiver"

#: autoload/calendar.gd
msgid "You booked a booth at the coin show. Collectors will find you."
msgstr "Vous avez réservé un stand au salon. Les collectionneurs vous trouveront."

#: autoload/calendar.gd
msgid "collectors pay well."
msgstr "les collectionneurs paient bien."

#: autoload/calendar.gd
msgid "gold buyers pay more."
msgstr "les acheteurs d'or paient plus."

#: autoload/calendar.gd
msgid "last day"
msgstr "dernier jour"

#: autoload/calendar.gd
msgid "on %s"
msgstr "%s"

#: autoload/calendar.gd
msgid "small gifts sell well."
msgstr "les petits cadeaux se vendent bien."

#: autoload/calendar.gd
msgid "tax of about {tax} due {tax_day}."
msgstr "environ {tax} d'impôts dus {tax_day}."

