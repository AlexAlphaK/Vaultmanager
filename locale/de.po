#: scenes/trading_desk/desk_session.gd
msgid "SOL"
msgstr "SOL"

#: scenes/trading_desk/desk_session.gd
msgid "SPY"
msgstr "SPY"

#: scenes/trading_desk/desk_session.gd
msgid "TSLA"
msgstr "TSLA"

#: scenes/trading_desk/desk_session.gd
msgid "The trading desk lost %s this morning."
msgstr "Der Handelstisch hat heute Morgen %s verloren."

#: scenes/trading_desk/desk_session.gd
msgid "The trading desk made %s this morning."
msgstr "Der Handelstisch hat heute Morgen %s verdient."

#: scenes/trading_desk/trading_desk.gd
msgid "1-%d pick a row. Esc closes out."
msgstr "1-%d wählt eine Zeile. Esc schließt alles."

#: scenes/trading_desk/trading_desk.gd
msgid "At the desk's limit. Close something first."
msgstr "Tischlimit erreicht. Schließ zuerst etwas."

#: scenes/trading_desk/trading_desk.gd
msgid "Back to the morning"
msgstr "Zurück zum Morgen"

#: scenes/trading_desk/trading_desk.gd
msgid "Buy if you think it rises, Sell to go short if you think it falls. At 17:00 everything closes and the result goes on today's ledger."
msgstr "Kauf, wenn du glaubst, es steigt, Verkauf, um short zu gehen, wenn es fällt. Um 17:00 wird alles geschlossen und das Ergebnis kommt ins heutige Kassenbuch."

#: scenes/trading_desk/trading_desk.gd
msgid "Close out now (Enter)"
msgstr "Jetzt schließen (Enter)"

#: scenes/trading_desk/trading_desk.gd
msgid "Closed"
msgstr "Geschlossen"

#: scenes/trading_desk/trading_desk.gd
msgid "Closing bell: %s"
msgstr "Schlussglocke: %s"

#: scenes/trading_desk/trading_desk.gd
msgid "Desk limit used"
msgstr "Genutztes Tischlimit"

#: scenes/trading_desk/trading_desk.gd
msgid "Desk lost %s today, after %s in fees."
msgstr "Der Tisch hat heute %s verloren, nach %s Gebühren."

#: scenes/trading_desk/trading_desk.gd
msgid "Desk made %s today, after %s in fees."
msgstr "Der Tisch hat heute %s verdient, nach %s Gebühren."

#: scenes/trading_desk/trading_desk.gd
msgid "Desk profit"
msgstr "Tischgewinn"

#: scenes/trading_desk/trading_desk.gd
msgid "Each tape replays a day that ends near today's live price, so the real 24h move is your edge. Hedge vault protects your stock if metals fall."
msgstr "Jedes Band spielt einen Tag ab, der nahe am heutigen Live-Kurs endet, also ist die echte 24h-Bewegung dein Vorteil. Tresor absichern schützt deinen Bestand, wenn Metalle fallen."

#: scenes/trading_desk/trading_desk.gd
msgid "Esc leaves without trading."
msgstr "Esc geht ohne Handel."

#: scenes/trading_desk/trading_desk.gd
msgid "Hedge vault (H)"
msgstr "Absichern (H)"

#: scenes/trading_desk/trading_desk.gd
msgid "Its profit"
msgstr "Sein Gewinn"

#: scenes/trading_desk/trading_desk.gd
msgid "LT"
msgstr "LT"

#: scenes/trading_desk/trading_desk.gd
msgid "Lifetime at the desk: %s."
msgstr "Insgesamt am Tisch: %s."

#: scenes/trading_desk/trading_desk.gd
msgid "Market"
msgstr "Markt"

#: scenes/trading_desk/trading_desk.gd
msgid "Morning session"
msgstr "Morgenhandel"

#: scenes/trading_desk/trading_desk.gd
msgid "No metal in the vault to hedge."
msgstr "Kein Metall im Tresor zum Absichern."

#: scenes/trading_desk/trading_desk.gd
msgid "Offline: the tapes are simulated."
msgstr "Offline: Die Bänder sind simuliert."

#: scenes/trading_desk/trading_desk.gd
msgid "On today's tape your vault gained %s on paper."
msgstr "Auf dem heutigen Band hat dein Tresor %s auf dem Papier gewonnen."

#: scenes/trading_desk/trading_desk.gd
msgid "On today's tape your vault lost %s on paper."
msgstr "Auf dem heutigen Band hat dein Tresor %s auf dem Papier verloren."

#: scenes/trading_desk/trading_desk.gd
msgid "POSITION"
msgstr "POSITION"

#: scenes/trading_desk/trading_desk.gd
msgid "PRICE"
msgstr "PREIS"

#: scenes/trading_desk/trading_desk.gd
msgid "Position"
msgstr "Position"

#: scenes/trading_desk/trading_desk.gd
msgid "Pre-market"
msgstr "Vorbörse"

#: scenes/trading_desk/trading_desk.gd
msgid "Previous / next row"
msgstr "Vorherige / nächste Zeile"

#: scenes/trading_desk/trading_desk.gd
msgid "RT"
msgstr "RT"

#: scenes/trading_desk/trading_desk.gd
msgid "Ring the opening bell"
msgstr "Zur Eröffnung läuten"

#: scenes/trading_desk/trading_desk.gd
msgid "Short the gold, silver and platinum in your vault, ounce for ounce, with up to half the desk's limit."
msgstr "Verkauf das Gold, Silber und Platin in deinem Tresor short, Unze für Unze, mit bis zur Hälfte des Tischlimits."

#: scenes/trading_desk/trading_desk.gd
msgid "Shorted the vault's metal with up to half the desk's limit."
msgstr "Das Metall im Tresor mit bis zur Hälfte des Tischlimits shortgesetzt."

#: scenes/trading_desk/trading_desk.gd
msgid "TODAY"
msgstr "HEUTE"

#: scenes/trading_desk/trading_desk.gd
msgid "TRADING DESK"
msgstr "HANDELSTISCH"

#: scenes/trading_desk/trading_desk.gd
msgid "Together"
msgstr "Zusammen"

#: scenes/trading_desk/trading_desk.gd
msgid "Trade %d%% of the desk's limit per click."
msgstr "Handle %d%% des Tischlimits pro Klick."

#: scenes/trading_desk/trading_desk.gd
msgid "Vault on paper"
msgstr "Tresor auf Papier"

#: scenes/trading_desk/trading_desk.gd
msgid "You watched the tape all day without a trade."
msgstr "Du hast den ganzen Tag das Band beobachtet, ohne zu handeln."

#: scenes/trading_desk/trading_desk.gd
msgid "Your hedge offset %d%% of the vault's move."
msgstr "Deine Absicherung hat %d%% der Tresorbewegung ausgeglichen."

#: scenes/trading_desk/trading_desk.gd
msgid "long "
msgstr "long "

#: scenes/trading_desk/trading_desk.gd
msgid "short "
msgstr "short "

#: scenes/tutorial/coach.gd
msgid "A customer"
msgstr "Ein Kunde"

#: scenes/tutorial/coach.gd
msgid "Are you sure?"
msgstr "Bist du sicher?"

#: scenes/tutorial/coach.gd
msgid "Bar test"
msgstr "Barrentest"

#: scenes/tutorial/coach.gd
msgid "Bills come out each night, and the day's numbers land here. Tomorrow morning, spend your profit on upgrades and keep an eye on the ticker. Good luck!"
msgstr "Rechnungen werden jede Nacht abgebucht, und die Zahlen des Tages landen hier. Morgen früh steck deinen Gewinn in Upgrades und behalte den Ticker im Auge. Viel Glück!"

#: scenes/tutorial/coach.gd
msgid "Bought!"
msgstr "Gekauft!"

#: scenes/tutorial/coach.gd
msgid "Burglars take whatever's left on the tray. Drag your stock into the safes: the floor safe never gets cracked, the wall safe sometimes does. Right-click turns a piece. The longer the lights stay on, the riskier it gets, so be quick."
msgstr "Einbrecher nehmen, was auf dem Tablett liegt. Zieh deinen Bestand in die Tresore: Der Bodentresor wird nie geknackt, der Wandtresor manchmal. Rechtsklick dreht ein Teil. Je länger das Licht brennt, desto riskanter, also beeil dich."

#: scenes/tutorial/coach.gd
msgid "Catching fakes earns reputation. Fakes you buy cost you the money and your stars when the assay lab checks them."
msgstr "Fälschungen erwischen bringt Ruf. Gekaufte Fälschungen kosten dich das Geld und Sterne, wenn das Prüflabor sie findet."

#: scenes/tutorial/coach.gd
msgid "Caught in the act"
msgstr "Auf frischer Tat"

#: scenes/tutorial/coach.gd
msgid "Caught!"
msgstr "Erwischt!"

#: scenes/tutorial/coach.gd
msgid "Day one done"
msgstr "Tag eins geschafft"

#: scenes/tutorial/coach.gd
msgid "Each tool checks one thing. Press 1 for the Scale and 2 for the Calipers, then compare each READING with the SPEC next to it."
msgstr "Jedes Werkzeug prüft eine Sache. Drück 1 für die Waage und 2 für den Messschieber, dann vergleiche jeden MESSWERT mit dem SOLL daneben."

#: scenes/tutorial/coach.gd
msgid "Five silver coins, please. A birthday present."
msgstr "Fünf Silbermünzen, bitte. Ein Geburtstagsgeschenk."

#: scenes/tutorial/coach.gd
msgid "Got it"
msgstr "Verstanden"

#: scenes/tutorial/coach.gd
msgid "Here comes someone else. Keep an eye on this one."
msgstr "Da kommt noch jemand. Behalte den hier im Auge."

#: scenes/tutorial/coach.gd
msgid "Jewellery appraisal"
msgstr "Schmuckschätzung"

#: scenes/tutorial/coach.gd
msgid "June left without selling. That's fine; there's always another customer."
msgstr "June ist gegangen, ohne zu verkaufen. Kein Problem, es kommt immer ein nächster Kunde."

#: scenes/tutorial/coach.gd
msgid "June wants to sell %d Silver Eagles. Melt today is what the silver in them is worth. Your offer is what you'd pay. Never buy coins untested: press Test coin."
msgstr "June möchte %d Silver Eagles verkaufen. Schmelzwert heute ist, was das Silber darin wert ist. Dein Angebot ist, was du zahlen würdest. Kauf nie ungeprüfte Münzen: Drück Prüfen."

#: scenes/tutorial/coach.gd
msgid "June's coins are in your vault now. You can see them under IN THE VAULT."
msgstr "Junes Münzen sind jetzt in deinem Tresor. Du siehst sie unter IM TRESOR."

#: scenes/tutorial/coach.gd
msgid "Live prices"
msgstr "Live-Preise"

#: scenes/tutorial/coach.gd
msgid "Lock up"
msgstr "Abschließen"

#: scenes/tutorial/coach.gd
msgid "Make an offer"
msgstr "Ein Angebot machen"

#: scenes/tutorial/coach.gd
msgid "My dad's old Silver Eagles. I'd like a fair price."
msgstr "Die alten Silver Eagles meines Vaters. Ich hätte gern einen fairen Preis."

#: scenes/tutorial/coach.gd
msgid "Next"
msgstr "Weiter"

#: scenes/tutorial/coach.gd
msgid "No deal"
msgstr "Kein Geschäft"

#: scenes/tutorial/coach.gd
msgid "Now you're on your own. Customers keep coming until 17:00, then you lock up the vault. Jewellery and bars have their own benches; you'll get a quick intro to each the first time."
msgstr "Jetzt bist du allein. Kunden kommen bis 17:00, dann schließt du den Tresor ab. Schmuck und Barren haben eigene Werkbänke; beim ersten Mal gibt es jeweils eine kurze Einführung."

#: scenes/tutorial/coach.gd
msgid "One more. This one wants to buy."
msgstr "Noch einer. Dieser will kaufen."

#: scenes/tutorial/coach.gd
msgid "Open up"
msgstr "Aufmachen"

#: scenes/tutorial/coach.gd
msgid "Played it safe"
msgstr "Auf Nummer sicher"

#: scenes/tutorial/coach.gd
msgid "Press Open the shop when you're ready."
msgstr "Drück \"Laden öffnen\", wenn du bereit bist."

#: scenes/tutorial/coach.gd
msgid "Priya wants 5 silver coins from your vault. She pays melt plus your premium. Press Sell."
msgstr "Priya möchte 5 Silbermünzen aus deinem Tresor. Sie zahlt Schmelzwert plus deinen Aufschlag. Drück Verkaufen."

#: scenes/tutorial/coach.gd
msgid "Read the bench"
msgstr "Lies den Tisch"

#: scenes/tutorial/coach.gd
msgid "Real coins. Press Make offer to buy them at your price."
msgstr "Echte Münzen. Drück Bieten, um sie zu deinem Preis zu kaufen."

#: scenes/tutorial/coach.gd
msgid "Real silver only drags a little. This coin snapped to the magnet: it's plated steel. Press Fake."
msgstr "Echtes Silber zieht nur leicht. Diese Münze ist am Magneten geklebt: plattierter Stahl. Drück Falsch."

#: scenes/tutorial/coach.gd
msgid "Selling"
msgstr "Verkaufen"

#: scenes/tutorial/coach.gd
msgid "Show me"
msgstr "Zeig her"

#: scenes/tutorial/coach.gd
msgid "Silver Eagles, cheap. Cash only, no questions, yeah?"
msgstr "Silver Eagles, billig. Nur bar, keine Fragen, ja?"

#: scenes/tutorial/coach.gd
msgid "Skip tutorial"
msgstr "Tutorial überspringen"

#: scenes/tutorial/coach.gd
msgid "Slick's in a hurry and won't haggle. Cheap coins from a nervous seller are often fake. Test them too."
msgstr "Slick hat es eilig und feilscht nicht. Billige Münzen von nervösen Verkäufern sind oft falsch. Prüf auch sie."

#: scenes/tutorial/coach.gd
msgid "Sold!"
msgstr "Verkauft!"

#: scenes/tutorial/coach.gd
msgid "Start the clock"
msgstr "Uhr starten"

#: scenes/tutorial/coach.gd
msgid "Steel fakes give themselves away to a magnet. Press 4."
msgstr "Stahlfälschungen verraten sich am Magneten. Drück 4."

#: scenes/tutorial/coach.gd
msgid "That's the counter"
msgstr "Das ist die Theke"

#: scenes/tutorial/coach.gd
msgid "The coin test"
msgstr "Der Münztest"

#: scenes/tutorial/coach.gd
msgid "The magnet"
msgstr "Der Magnet"

#: scenes/tutorial/coach.gd
msgid "The ticker shows today's spot prices from the real market. Every coin's value follows them, so the same coin is worth more on some days than others."
msgstr "Der Ticker zeigt die heutigen Spotpreise vom echten Markt. Jeder Münzwert folgt ihnen, also ist dieselbe Münze an manchen Tagen mehr wert als an anderen."

#: scenes/tutorial/coach.gd
msgid "Those coins snapped to the magnet. You can still press Refuse."
msgstr "Die Münzen klebten am Magneten. Du kannst noch Ablehnen drücken."

#: scenes/tutorial/coach.gd
msgid "Those were plated steel. The assay lab will catch them soon and you'll lose what you paid. Always test first."
msgstr "Das war plattierter Stahl. Das Prüflabor findet das bald und du verlierst, was du gezahlt hast. Immer erst prüfen."

#: scenes/tutorial/coach.gd
msgid "Too good to be true?"
msgstr "Zu schön, um wahr zu sein?"

#: scenes/tutorial/coach.gd
msgid "Tungsten weighs almost the same as gold, so the scale isn't enough. Press 3 and sweep the ultrasound probe over the whole bar: the echo must stay inside the gate, and an early echo means tungsten inside. Read the serial under the loupe; a copied serial gets flagged. The XRF gun comes as an upgrade."
msgstr "Wolfram wiegt fast so viel wie Gold, die Waage reicht also nicht. Drück 3 und fahr die Ultraschallsonde über den ganzen Barren: Das Echo muss im Gate bleiben, ein frühes Echo heißt Wolfram innen. Lies die Seriennummer unter der Lupe; eine kopierte wird markiert. Die RFA-Pistole gibt es als Upgrade."

#: scenes/tutorial/coach.gd
msgid "Turning away untested coins is safe. Testing them proves it, and catching a fake earns reputation."
msgstr "Ungeprüfte Münzen abzulehnen ist sicher. Prüfen beweist es, und eine erwischte Fälschung bringt Ruf."

#: scenes/tutorial/coach.gd
msgid "Tutorial skipped. Good luck!"
msgstr "Tutorial übersprungen. Viel Glück!"

#: scenes/tutorial/coach.gd
msgid "Uh oh"
msgstr "Oh oh"

#: scenes/tutorial/coach.gd
msgid "Weigh the piece. Then press 2 to rub a streak on the touchstone and drop acids on it (Q-Y): the streak survives acids up to its karat, and base metal fizzes. The Tester checks a stone; moissanite fools it, so look for doubled facet edges under the loupe. Set the grade (G) and the stone (D), then Finish appraisal."
msgstr "Wieg das Stück. Dann drück 2, reib einen Strich auf den Prüfstein und gib Säuren darauf (Q-Y): Der Strich übersteht Säuren bis zu seinem Karat, unedles Metall schäumt. Der Tester prüft einen Stein; Moissanit täuscht ihn, also achte unter der Lupe auf doppelte Facettenkanten. Stell den Gehalt (G) und den Stein (D) ein, dann Schätzung beenden."

#: scenes/tutorial/coach.gd
msgid "Weight, diameter and thickness all match the spec. This is a real Silver Eagle. Press Genuine."
msgstr "Gewicht, Durchmesser und Dicke passen zur Spezifikation. Das ist ein echter Silver Eagle. Drück Echt."

#: scenes/tutorial/coach.gd
msgid "Welcome to your shop"
msgstr "Willkommen in deinem Laden"

#: scenes/tutorial/coach.gd
msgid "You buy and sell gold, silver and platinum at real market prices. Your goal: the biggest store in town. Let's serve your first customers together."
msgstr "Du kaufst und verkaufst Gold, Silber und Platin zu echten Marktpreisen. Dein Ziel: der größte Laden der Stadt. Bedienen wir zusammen deine ersten Kunden."

#: scenes/tutorial/coach.gd
msgid "You pay sellers a little under melt and charge buyers a little over it. That gap is your profit. The -/+ buttons change both, but push too far and customers walk."
msgstr "Du zahlst Verkäufern etwas unter dem Schmelzwert und verlangst von Käufern etwas darüber. Die Spanne ist dein Gewinn. Die -/+-Knöpfe ändern beides, aber übertreib es, und die Kunden gehen."

#: scenes/tutorial/coach.gd
msgid "Your first customer"
msgstr "Dein erster Kunde"

#: scenes/tutorial/coach.gd
msgid "Your first customer is walking up to the counter."
msgstr "Dein erster Kunde kommt zur Theke."

#: scenes/tutorial/coach.gd
msgid "Your margins"
msgstr "Deine Spanne"

#: scenes/vault/vault.gd
msgid "Alarm: -%d%% risk"
msgstr "Alarm: -%d%% Risiko"

#: scenes/vault/vault.gd
msgid "Break-in overnight! Lost %s."
msgstr "Einbruch über Nacht! %s verloren."

#: scenes/vault/vault.gd
msgid "Break-in risk"
msgstr "Einbruchsrisiko"

#: scenes/vault/vault.gd
msgid "Break-in risk was %d%%, with %d%% of the value locked away."
msgstr "Das Einbruchsrisiko lag bei %d%%, mit %d%% des Werts weggeschlossen."

#: scenes/vault/vault.gd
msgid "Break-in: %s!"
msgstr "Einbruch: %s!"

#: scenes/vault/vault.gd
msgid "Burglars can't crack it"
msgstr "Einbrecher knacken ihn nicht"

#: scenes/vault/vault.gd
msgid "Closing time"
msgstr "Feierabend"

#: scenes/vault/vault.gd
msgid "Cracked the wall safe: %s."
msgstr "Wandtresor geknackt: %s."

#: scenes/vault/vault.gd
msgid "Crews crack it %d%% of the time"
msgstr "Banden knacken ihn zu %d%%"

#: scenes/vault/vault.gd
msgid "Crews crack it %d%%, pros %d%%"
msgstr "Banden knacken ihn zu %d%%, Profis zu %d%%"

#: scenes/vault/vault.gd
msgid "Drag stock into the safes. Right-click or R turns a piece. What's left on the tray is easy pickings, and the longer the lights stay on, the likelier a break-in."
msgstr "Zieh den Bestand in die Tresore. Rechtsklick oder R dreht ein Teil. Was auf dem Tablett bleibt, ist leichte Beute, und je länger das Licht brennt, desto wahrscheinlicher ein Einbruch."

#: scenes/vault/vault.gd
msgid "Enter locks up. At zero it locks itself."
msgstr "Enter schließt ab. Bei null schließt es von selbst."

#: scenes/vault/vault.gd
msgid "FLOOR SAFE"
msgstr "BODENTRESOR"

#: scenes/vault/vault.gd
msgid "Grabbed the best of the counter tray: %s. They left the rest."
msgstr "Haben das Beste vom Thekentablett geschnappt: %s. Den Rest ließen sie liegen."

#: scenes/vault/vault.gd
msgid "Insurance pays back %s."
msgstr "Die Versicherung erstattet %s."

#: scenes/vault/vault.gd
msgid "Left on the tray"
msgstr "Auf dem Tablett"

#: scenes/vault/vault.gd
msgid "Lights out in"
msgstr "Licht aus in"

#: scenes/vault/vault.gd
msgid "Lock up now"
msgstr "Jetzt abschließen"

#: scenes/vault/vault.gd
msgid "Locked away"
msgstr "Weggeschlossen"

#: scenes/vault/vault.gd
msgid "Nobody came, and everything was locked away."
msgstr "Niemand kam, und alles war weggeschlossen."

#: scenes/vault/vault.gd
msgid "Nobody came. Lucky: %s sat out on the counter all night."
msgstr "Niemand kam. Glück gehabt: %s lag die ganze Nacht auf der Theke."

#: scenes/vault/vault.gd
msgid "Quiet night"
msgstr "Ruhige Nacht"

#: scenes/vault/vault.gd
msgid "Quiet night. The vault was untouched."
msgstr "Ruhige Nacht. Der Tresor blieb unberührt."

#: scenes/vault/vault.gd
msgid "See the day's results"
msgstr "Tagesergebnis ansehen"

#: scenes/vault/vault.gd
msgid "The cameras caught them. Police got back %s."
msgstr "Die Kameras haben sie erfasst. Die Polizei holte %s zurück."

#: scenes/vault/vault.gd
msgid "The customer ledger is gone. Reputation -%.1f."
msgstr "Das Kundenbuch ist weg. Ruf -%.1f."

#: scenes/vault/vault.gd
msgid "The floor safe held."
msgstr "Der Bodentresor hielt."

#: scenes/vault/vault.gd
msgid "They couldn't crack the wall safe."
msgstr "Den Wandtresor bekamen sie nicht auf."

#: scenes/vault/vault.gd
msgid "They never touched the safes."
msgstr "Die Tresore haben sie nicht angerührt."

#: scenes/vault/vault.gd
msgid "Took everything on the counter tray: %s."
msgstr "Alles vom Thekentablett mitgenommen: %s."

#: scenes/vault/vault.gd
msgid "Total lost: %s."
msgstr "Verlust gesamt: %s."

#: scenes/vault/vault.gd
msgid "VAULT LOCK-UP"
msgstr "TRESOR ABSCHLIESSEN"

#: scenes/vault/vault.gd
msgid "WALL SAFE"
msgstr "WANDTRESOR"

#: scenes/vault/vault.gd
msgid "Worth %s today"
msgstr "Heute %s wert"

#: scenes/vault/vault.gd
msgid "and more"
msgstr "und mehr"

#: scenes/vault/vault_layout.gd
msgid "%s in notes"
msgstr "%s in Scheinen"

#: scenes/vault/vault_layout.gd
msgid "Cash straps"
msgstr "Geldbündel"

#: scenes/vault/vault_layout.gd
msgid "Counter tray"
msgstr "Thekentablett"

#: scenes/vault/vault_layout.gd
msgid "Customer ledger"
msgstr "Kundenbuch"

#: scenes/vault/vault_layout.gd
msgid "Floor safe"
msgstr "Bodentresor"

#: scenes/vault/vault_layout.gd
msgid "Gold coin box"
msgstr "Goldmünzenbox"

#: scenes/vault/vault_layout.gd
msgid "Insurance payout"
msgstr "Versicherungsleistung"

#: scenes/vault/vault_layout.gd
msgid "Lose it: -%.1f reputation"
msgstr "Weg damit: -%.1f Ruf"

#: scenes/vault/vault_layout.gd
msgid "Monster box"
msgstr "Monsterbox"

#: scenes/vault/vault_layout.gd
msgid "Names and addresses."
msgstr "Namen und Adressen."

#: scenes/vault/vault_layout.gd
msgid "Platinum box"
msgstr "Platinbox"

#: scenes/vault/vault_layout.gd
msgid "Silver tube"
msgstr "Silberrolle"

#: scenes/vault/vault_layout.gd
msgid "Wall safe"
msgstr "Wandtresor"

