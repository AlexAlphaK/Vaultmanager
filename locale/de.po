msgstr "Jeder Platz speichert jeden Morgen und jeden Abend."

#: ui/save_slots_panel.gd
msgid "Play"
msgstr "Spielen"

#: ui/save_slots_panel.gd
msgid "Slot %d deleted."
msgstr "Platz %d gelöscht."

#: ui/save_slots_panel.gd
