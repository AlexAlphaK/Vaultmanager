#: autoload/calendar.gd
msgid "%d more day"
msgid_plural "%d more days"
msgstr[0] "noch %d Tag"
msgstr[1] "noch %d Tage"

#: autoload/calendar.gd
msgid "%s (in %d days)"
msgstr "%s (in %d Tagen)"

#: autoload/calendar.gd
msgid "%s is over. %s starts tomorrow."
msgstr "%s ist vorbei. %s beginnt morgen."

#: autoload/calendar.gd
msgid "%s is over. You served %d of its customers."
msgstr "%s ist vorbei. Du hast %d der Kunden bedient."

#: autoload/calendar.gd
msgid "%s, day %d of %d"
msgstr "%s, Tag %d von %d"

#: autoload/calendar.gd
msgid "A silver coin for my nephew's stocking, please."
msgstr "Eine Silbermünze für den Strumpf meines Neffen, bitte."

#: autoload/calendar.gd
msgid "Autumn"
msgstr "Herbst"

#: autoload/calendar.gd
msgid "COIN SHOW: collectors from three counties are in town for the weekend."
msgstr "MÜNZMESSE: Sammler aus drei Landkreisen sind übers Wochenende in der Stadt."

#: autoload/calendar.gd
msgid "Coin show booth"
msgstr "Messestand"

#: autoload/calendar.gd
msgid "Collectors pay well for exact coins and rare ones. A booth brings more of them."
msgstr "Sammler zahlen gut für bestimmte und seltene Münzen. Ein Stand lockt mehr von ihnen an."

#: autoload/calendar.gd
msgid "Debug: skipped ahead to day %d, %s."
msgstr "Debug: zu Tag %d gesprungen, %s."

#: autoload/calendar.gd
msgid "Everyone's paying up for gold this week. My turn."
msgstr "Diese Woche zahlen alle mehr für Gold. Jetzt bin ich dran."

#: autoload/calendar.gd
msgid "GOLD FEVER: Prospector Days are on and the whole town wants gold."
msgstr "GOLDFIEBER: Die Goldgräbertage laufen und die ganze Stadt will Gold."

#: autoload/calendar.gd
msgid "Gift buyers want small coins and pay a good premium. Keep the shelves full."
msgstr "Geschenkkäufer wollen kleine Münzen und zahlen gut. Halte die Regale voll."

#: autoload/calendar.gd
msgid "Gift-wrapped, if you can. It's for my mum."
msgstr "Als Geschenk verpackt, wenn's geht. Für meine Mama."

#: autoload/calendar.gd
msgid "Gold buyers pay more all week. Stock up on gold coins."
msgstr "Goldkäufer zahlen die ganze Woche mehr. Deck dich mit Goldmünzen ein."

#: autoload/calendar.gd
msgid "Gold fever week"
msgstr "Goldfieber-Woche"

#: autoload/calendar.gd
msgid "Gold fever, they call it. I've caught it."
msgstr "Goldfieber nennen sie das. Mich hat's erwischt."

#: autoload/calendar.gd
msgid "HOLIDAY RUSH: shoppers want coins to give as gifts, and they pay for the wrapping."
msgstr "FESTTAGSANSTURM: Kunden wollen Münzen zum Verschenken und zahlen fürs Einpacken."

#: autoload/calendar.gd
msgid "Holiday gift rush"
msgstr "Festtagsansturm"

#: autoload/calendar.gd
msgid "In town for the show. What have you got?"
msgstr "Bin wegen der Messe hier. Was haben Sie?"

#: autoload/calendar.gd
msgid "Last-minute present. You're a lifesaver."
msgstr "Geschenk in letzter Minute. Sie retten mich."

#: autoload/calendar.gd
msgid "My accountant says sell. So I'm selling."
msgstr "Mein Steuerberater sagt: verkaufen. Also verkaufe ich."

#: autoload/calendar.gd
msgid "Owe more than I thought this year. Cash, please."
msgstr "Ich schulde mehr als gedacht. Bar, bitte."

#: autoload/calendar.gd
msgid "Panned this lot at the festival. Well, my grandpa did."
msgstr "Das hab ich beim Fest gewaschen. Na ja, mein Opa."

#: autoload/calendar.gd
msgid "Prospector Days! I want real gold, not the fudge kind."
msgstr "Goldgräbertage! Ich will echtes Gold, keine Schokotaler."

#: autoload/calendar.gd
msgid "Saw the parade. Now I want a gold coin of my own."
msgstr "Hab den Umzug gesehen. Jetzt will ich eine eigene Goldmünze."

#: autoload/calendar.gd
msgid "Sellers want cash for their tax bills. Keep cash in the safe."
msgstr "Verkäufer brauchen Bargeld für die Steuer. Halte Bargeld im Tresor."

#: autoload/calendar.gd
msgid "Something gold for my wife. Not too big, I'm not made of money."
msgstr "Etwas aus Gold für meine Frau. Nicht zu groß, ich bin kein Krösus."

#: autoload/calendar.gd
msgid "Spring"
msgstr "Frühling"

#: autoload/calendar.gd
msgid "Summer"
msgstr "Sommer"

#: autoload/calendar.gd
msgid "TAX SEASON: the town is selling metal to pay the taxman. Tax Day is {last}."
msgstr "STEUERZEIT: Die Stadt verkauft Metall, um das Finanzamt zu bezahlen. Steuertag ist {last}."

#: autoload/calendar.gd
msgid "Tax Day"
msgstr "Steuertag"

#: autoload/calendar.gd
msgid "Tax Day: no profit since the last one, so no tax to pay."
msgstr "Steuertag: kein Gewinn seit dem letzten, also keine Steuer."

#: autoload/calendar.gd
msgid "Tax Day: you paid %s, %d%% of your %s profit (after costs) since the last one."
msgstr "Steuertag: Du hast %s gezahlt, %d%% deines Gewinns von %s (nach Kosten) seit dem letzten."

#: autoload/calendar.gd
msgid "Tax season"
msgstr "Steuerzeit"

#: autoload/calendar.gd
msgid "The taxman wants his cut. These have to go."
msgstr "Das Finanzamt will seinen Anteil. Die müssen weg."

#: autoload/calendar.gd
msgid "Tomorrow: %s. %s"
msgstr "Morgen: %s. %s"

#: autoload/calendar.gd
msgid "Town coin show"
msgstr "Münzmesse"

#: autoload/calendar.gd
msgid "Winter"
msgstr "Winter"

#: autoload/calendar.gd
msgid "You booked a booth at the coin show. Collectors will find you."
msgstr "Du hast einen Stand auf der Münzmesse gebucht. Sammler werden dich finden."

#: autoload/calendar.gd
msgid "collectors pay well."
msgstr "Sammler zahlen gut."

#: autoload/calendar.gd
msgid "gold buyers pay more."
msgstr "Goldkäufer zahlen mehr."

#: autoload/calendar.gd
msgid "last day"
msgstr "letzter Tag"

#: autoload/calendar.gd
msgid "on %s"
msgstr "am %s"

#: autoload/calendar.gd
msgid "small gifts sell well."
msgstr "kleine Geschenke gehen gut."

#: autoload/calendar.gd
msgid "tax of about {tax} due {tax_day}."
msgstr "Steuer von etwa {tax} fällig {tax_day}."

#: autoload/calendar.gd scenes/shop/day_panels.gd
msgid "today"
msgstr "heute"

#: autoload/calendar.gd
msgid "tomorrow"
msgstr "morgen"

#: autoload/calendar.gd
msgid "tonight"
msgstr "heute Abend"

#: autoload/customers.gd
msgid "%s coins for the collection. I pay for quality."
msgstr "%s-Münzen für die Sammlung. Ich zahle für Qualität."

#: autoload/customers.gd
msgid "%s has found another shop."
msgstr "%s hat einen anderen Laden gefunden."

#: autoload/customers.gd
msgid "%s is back."
msgstr "%s ist wieder da."

#: autoload/customers.gd
msgid "%s sold you fakes and walked off laughing."
msgstr "%s hat dir Fälschungen verkauft und ist lachend gegangen."

#: autoload/customers.gd
msgid "%s walked in."
msgstr "%s ist hereingekommen."

#: autoload/customers.gd
msgid "%s will come back when you have %s in stock."
msgstr "%s kommt wieder, wenn du %s auf Lager hast."

#: autoload/customers.gd
msgid "%s won't be coming back."
msgstr "%s kommt nicht mehr wieder."

#: autoload/customers.gd
msgid "%s%.1f stars"
msgstr "%s%.1f Sterne"

#: autoload/customers.gd
msgid "Ada Okafor"
msgstr "Ada Okafor"

#: autoload/customers.gd
msgid "Ada Okafor is your newest customer. Her grandma is very proud."
msgstr "Ada Okafor ist deine neueste Kundin. Ihre Oma ist sehr stolz."

#: autoload/customers.gd
msgid "Ada got into the science programme! Ten more for the fund."
msgstr "Ada hat den Platz im Wissenschaftsprogramm! Zehn mehr für den Fonds."

#: autoload/customers.gd
msgid "Any %s coins? Nice strike, no spots, please."
msgstr "Haben Sie %s-Münzen? Schöne Prägung, keine Flecken, bitte."

#: autoload/customers.gd
msgid "Back from the dead! Diamond hands. Give me your shiniest."
msgstr "Zurück von den Toten! Diamond Hands. Gib mir dein Glänzendstes."

#: autoload/customers.gd
msgid "Brayden"
msgstr "Brayden"

#: autoload/customers.gd
msgid "Britannias next. Three, for a display on the history of coinage."
msgstr "Als Nächstes Britannias. Drei, für eine Ausstellung zur Geschichte des Münzwesens."

#: autoload/customers.gd
msgid "Buying the crypto dip. Need cash for it, bro."
msgstr "Ich kaufe den Krypto-Dip. Brauch Bargeld dafür, Bro."

#: autoload/customers.gd
msgid "Cash only. No paperwork. You understand."
msgstr "Nur bar. Kein Papierkram. Sie verstehen."

#: autoload/customers.gd
msgid "Chad"
msgstr "Chad"

#: autoload/customers.gd
msgid "Chad bought gold to 'diversify his bag'."
msgstr "Chad hat Gold gekauft, um \"sein Portfolio zu streuen\"."

#: autoload/customers.gd
msgid "Chad posted your shop to all his followers. 'Based gold guy.'"
msgstr "Chad hat deinen Laden bei all seinen Followern gepostet. \"Echter Gold-Typ.\""

#: autoload/customers.gd
msgid "Chad sold his gold back after a bad week in crypto."
msgstr "Chad hat sein Gold nach einer miesen Krypto-Woche zurückverkauft."

#: autoload/customers.gd
msgid "Detective Ruiz"
msgstr "Detective Ruiz"

#: autoload/customers.gd
msgid "Detective Ruiz paid you the reward for Vinnie's fakes."
msgstr "Detective Ruiz hat dir die Belohnung für Vinnies Fälschungen gezahlt."

#: autoload/customers.gd
msgid "Detective Ruiz warned you about buying from Vinnie."
msgstr "Detective Ruiz hat dich gewarnt, bei Vinnie zu kaufen."

#: autoload/customers.gd
msgid "Diversifying my bag. Need gold, like, now."
msgstr "Ich streu mein Portfolio. Brauch Gold, so, sofort."

#: autoload/customers.gd
msgid "Don't ask about my portfolio. Just buy these."
msgstr "Frag nicht nach meinem Portfolio. Kauf die einfach."

#: autoload/customers.gd
msgid "Dr. Vance is building a museum display on the history of coinage."
msgstr "Dr. Vance baut eine Museumsausstellung zur Geschichte des Münzwesens auf."

#: autoload/customers.gd
msgid "Dr. Vance's display opens at the town museum next week."
msgstr "Die Ausstellung von Dr. Vance öffnet nächste Woche im Stadtmuseum."

#: autoload/customers.gd
msgid "Dr. Vance, a collector, added your Krugerrand to her cabinet."
msgstr "Dr. Vance, eine Sammlerin, hat deinen Krugerrand in ihre Vitrine gestellt."

#: autoload/customers.gd
msgid "Everything's negotiable, friend."
msgstr "Alles ist verhandelbar, mein Freund."

#: autoload/customers.gd
msgid "Fresh from my uncle's estate. Very fresh. Cash, yeah?"
msgstr "Frisch aus dem Nachlass meines Onkels. Sehr frisch. Bar, ja?"

#: autoload/customers.gd
msgid "Gold's the OG blockchain, bro."
msgstr "Gold ist die Ur-Blockchain, Bro."

#: autoload/customers.gd
msgid "Got liquidated. Need those eagles turned back into fiat. Don't tell anyone."
msgstr "Liquidiert worden. Die Eagles müssen wieder zu Fiat werden. Sag's keinem."

#: autoload/customers.gd
msgid "Got margin-called. Need fiat, fast."
msgstr "Margin Call gekriegt. Brauch Fiat, schnell."

#: autoload/customers.gd
msgid "Grandma's silver paid for my first year. Now I'm starting my own stack."
msgstr "Omas Silber hat mein erstes Jahr bezahlt. Jetzt fange ich meinen eigenen Stapel an."

#: autoload/customers.gd
msgid "Grandpa Lev"
msgstr "Grandpa Lev"

#: autoload/customers.gd
msgid "Grandpa Lev sold you the first of his late wife's coins. He'll be back."
msgstr "Grandpa Lev hat dir die ersten Münzen seiner verstorbenen Frau verkauft. Er kommt wieder."

#: autoload/customers.gd
msgid "Grandpa Lev sold you the last of Mira's coins. He looked lighter, somehow."
msgstr "Grandpa Lev hat dir die letzten von Miras Münzen verkauft. Er wirkte irgendwie leichter."

#: autoload/customers.gd
msgid "Grandpa Lev told the whole bowling league about your shop."
msgstr "Grandpa Lev hat dem ganzen Kegelverein von deinem Laden erzählt."

#: autoload/customers.gd
msgid "Grandpa Lev told you how Mira saved a coin from every trip they took."
msgstr "Grandpa Lev hat erzählt, wie Mira von jeder Reise eine Münze aufhob."

#: autoload/customers.gd
msgid "Her favourite. I kept this one till last."
msgstr "Ihre liebste. Die hab ich bis zuletzt behalten."

#: autoload/customers.gd
msgid "I collect %s coins. Nothing else will do."
msgstr "Ich sammle %s-Münzen. Nichts anderes kommt in Frage."

#: autoload/customers.gd
msgid "I collect Krugerrands. Do you have one with a crisp springbok?"
msgstr "Ich sammle Krugerrands. Haben Sie einen mit scharfem Springbock?"

#: autoload/customers.gd
msgid "I never pay sticker. Let's talk."
msgstr "Ich zahle nie den Listenpreis. Reden wir."

#: autoload/customers.gd
msgid "Jaxon"
msgstr "Jaxon"

#: autoload/customers.gd
msgid "Just took profits. Turn it into something shiny."
msgstr "Gerade Gewinne mitgenommen. Mach was Glänzendes draus."

#: autoload/customers.gd
msgid "Last time, I promise. These ones are definitely real."
msgstr "Letztes Mal, versprochen. Die sind wirklich echt."

#: autoload/customers.gd
msgid "Last top-up before she goes. Ten more, and wish her luck."
msgstr "Letzte Aufstockung, bevor sie geht. Zehn mehr, und drücken Sie ihr die Daumen."

#: autoload/customers.gd
msgid "Let's not insult each other. What's your real number?"
msgstr "Beleidigen wir uns nicht. Was ist Ihr echter Preis?"

#: autoload/customers.gd
msgid "Moonboy Mike"
msgstr "Moonboy Mike"

#: autoload/customers.gd
msgid "More of Mira's collection. She'd want it to go to someone honest."
msgstr "Mehr aus Miras Sammlung. Sie hätte gewollt, dass sie an jemand Ehrliches geht."

#: autoload/customers.gd
msgid "Mrs. Okafor finished Ada's college fund."
msgstr "Mrs. Okafor hat Adas Studienfonds vollgemacht."

#: autoload/customers.gd
msgid "Mrs. Okafor started a college fund in silver for her granddaughter."
msgstr "Mrs. Okafor hat für ihre Enkelin einen Studienfonds in Silber angelegt."

#: autoload/customers.gd
msgid "Mrs. Okafor's granddaughter got into the science programme."
msgstr "Mrs. Okafors Enkelin hat einen Platz im Wissenschaftsprogramm."

#: autoload/customers.gd
msgid "My Mira bought one of these every birthday. Time to let a few go."
msgstr "Meine Mira hat zu jedem Geburtstag eine davon gekauft. Zeit, ein paar abzugeben."

#: autoload/customers.gd
msgid "My cousin's coins. He's... away."
msgstr "Die Münzen meines Cousins. Er ist... verreist."

#: autoload/customers.gd
msgid "My grandson graduates Friday. I want to buy him a gold coin, and I want it from you."
msgstr "Mein Enkel macht Freitag seinen Abschluss. Ich will ihm eine Goldmünze kaufen, und zwar bei Ihnen."

#: autoload/customers.gd
msgid "My old teacher's eagles. I want them in good hands, not a fair price."
msgstr "Die Eagles meines alten Lehrers. Ich will sie in guten Händen, nicht zum besten Preis."

#: autoload/customers.gd
msgid "New batch. Same uncle. Different estate."
msgstr "Neue Ladung. Gleicher Onkel. Anderer Nachlass."

#: autoload/customers.gd
msgid "Priced to move. Don't ask where they're from."
msgstr "Kampfpreis. Frag nicht, wo die herkommen."

#: autoload/customers.gd autoload/orders.gd
msgid "Professor Hale"
msgstr "Professor Hale"

#: autoload/customers.gd
msgid "Quick deal, yeah? I'm double parked."
msgstr "Schneller Deal, ja? Ich steh in zweiter Reihe."

#: autoload/customers.gd
msgid "Reward"
msgstr "Belohnung"

#: autoload/customers.gd autoload/story.gd
msgid "Reward: "
msgstr "Belohnung: "

#: autoload/customers.gd
msgid "Silver for my granddaughter Ada's college fund. Five, please."
msgstr "Silber für den Studienfonds meiner Enkelin Ada. Fünf, bitte."

#: autoload/customers.gd
msgid "Some Guy"
msgstr "Some Guy"

#: autoload/customers.gd
msgid "Tanner"
msgstr "Tanner"

#: autoload/customers.gd
msgid "The centrepiece: a platinum eagle. The museum opens next week."
msgstr "Das Herzstück: ein Platinum Eagle. Das Museum öffnet nächste Woche."

#: autoload/customers.gd
msgid "The museum display credits your shop. People are talking."
msgstr "Die Museumsausstellung nennt deinen Laden. Die Leute reden."

#: autoload/customers.gd
msgid "Took some profits, bro. Gold's the original blockchain."
msgstr "Hab Gewinne mitgenommen, Bro. Gold ist die Original-Blockchain."

#: autoload/customers.gd
msgid "Two-Phones Tony"
msgstr "Two-Phones Tony"

#: autoload/customers.gd
msgid "Vinnie"
msgstr "Vinnie"

#: autoload/customers.gd
msgid "Vinnie's been passing fakes all over town. Some ended up in your vault. Test your coins."
msgstr "Vinnie verteilt Fälschungen in der ganzen Stadt. Einige sind in deinem Tresor gelandet. Prüf deine Münzen."

#: autoload/customers.gd
msgid "We picked up Vinnie's counterfeit ring. Your tips helped. The town's reward is yours."
msgstr "Wir haben Vinnies Fälscherring hochgenommen. Ihre Hinweise haben geholfen. Die Belohnung der Stadt gehört Ihnen."

#: autoload/customers.gd
msgid "You caught %s's %s fakes. He'll try again."
msgstr "Du hast %ss %s-Fälschungen erwischt. Er versucht es wieder."

#: autoload/customers.gd
msgid "You caught %s's fakes again. Word is the police are interested."
msgstr "Du hast %ss Fälschungen wieder erwischt. Es heißt, die Polizei interessiert sich."

#: autoload/customers.gd
msgid "collector"
msgstr "Sammler"

#: autoload/customers.gd
msgid "crypto bro"
msgstr "Krypto-Bro"

#: autoload/customers.gd
msgid "haggler"
msgstr "Feilscher"

#: autoload/customers.gd
msgid "looks nervous"
msgstr "wirkt nervös"

#: autoload/customers.gd
msgid "old coin"
msgstr "alte Münze"

#: autoload/customers.gd
msgid "regular"
msgstr "Stammkunde"

#: autoload/day.gd
msgid "Friday"
msgstr "Freitag"

#: autoload/day.gd
msgid "Insurance"
msgstr "Versicherung"

#: autoload/day.gd
msgid "Monday"
msgstr "Montag"

#: autoload/day.gd
msgid "Overdraft interest"
msgstr "Überziehungszinsen"

#: autoload/day.gd
msgid "Rent"
msgstr "Miete"

#: autoload/day.gd scenes/shop/rush_hours.gd
msgid "Saturday"
msgstr "Samstag"

#: autoload/day.gd
msgid "Sunday"
msgstr "Sonntag"

#: autoload/day.gd
msgid "Thursday"
msgstr "Donnerstag"

#: autoload/day.gd
msgid "Tuesday"
msgstr "Dienstag"

#: autoload/day.gd
msgid "Upkeep"
msgstr "Unterhalt"

#: autoload/day.gd
msgid "Wednesday"
msgstr "Mittwoch"

#: autoload/day.gd
msgid "You are overdrawn. The bank charges interest every night."
msgstr "Du bist im Minus. Die Bank berechnet jede Nacht Zinsen."

#: autoload/market_events.gd
msgid "BITCOIN CRASHES {move}. Burned crypto traders want something real."
msgstr "BITCOIN STÜRZT AB {move}. Verbrannte Krypto-Trader wollen etwas Echtes."

#: autoload/market_events.gd
msgid "BITCOIN SOARS {move}. Gold bugs sell up to chase crypto."
msgstr "BITCOIN HEBT AB {move}. Goldfans verkaufen, um Krypto zu jagen."

#: autoload/market_events.gd
msgid "Buying the dip, like my dad taught me."
msgstr "Ich kaufe den Dip, wie mein Vater es mir beigebracht hat."

#: autoload/market_events.gd
msgid "CHIP STOCKS PLUNGE: NVIDIA {move}. Tech money looks for shelter in silver."
msgstr "CHIPAKTIEN BRECHEN EIN: NVIDIA {move}. Tech-Geld sucht Schutz in Silber."

#: autoload/market_events.gd
msgid "DOGECOIN MOONS {move}. Lucky winners want to lock in their gains in gold."
msgstr "DOGECOIN GEHT ZUM MOND {move}. Glückliche Gewinner sichern ihre Gewinne in Gold."

#: autoload/market_events.gd
msgid "Dog money paid off. Turning it into real money."
msgstr "Hundegeld hat sich gelohnt. Mach ich jetzt zu echtem Geld."

#: autoload/market_events.gd
msgid "Done with crypto. Give me something I can hold."
msgstr "Schluss mit Krypto. Geben Sie mir was zum Anfassen."

#: autoload/market_events.gd
msgid "Forums say buy physical. How many do you have?"
msgstr "In den Foren heißt es: physisch kaufen. Wie viele haben Sie?"

#: autoload/market_events.gd
msgid "GOLD JUMPS {move}. Folks dig out old coins to cash in at the top."
msgstr "GOLD SPRINGT {move}. Die Leute kramen alte Münzen hervor, um oben zu verkaufen."

#: autoload/market_events.gd
msgid "GOLD SLIDES {move}. Panic sellers want out before it drops further."
msgstr "GOLD RUTSCHT {move}. Panikverkäufer wollen raus, bevor es weiter fällt."

#: autoload/market_events.gd
msgid "Gold's boring. Selling to buy tech."
msgstr "Gold ist langweilig. Ich verkaufe für Tech-Aktien."

#: autoload/market_events.gd
msgid "Gold's crashing! Take them before they're worth nothing."
msgstr "Gold stürzt ab! Nehmen Sie die, bevor sie nichts mehr wert sind."

#: autoload/market_events.gd
msgid "Gold's up again. Time to cash in."
msgstr "Gold steigt wieder. Zeit, Kasse zu machen."

#: autoload/market_events.gd
msgid "Heard spot is flying today. What'll you give me?"
msgstr "Hab gehört, der Spot geht heute durch die Decke. Was geben Sie mir?"

#: autoload/market_events.gd
msgid "Lost a month's pay on chips today. Silver, please."
msgstr "Heute einen Monatslohn mit Chips verloren. Silber, bitte."

#: autoload/market_events.gd
msgid "Much profit. Very gold. Wow."
msgstr "Viel Gewinn. Sehr Gold. Wow."

#: autoload/market_events.gd
msgid "My broker isn't picking up. You'll buy these, right?"
msgstr "Mein Broker geht nicht ran. Die kaufen Sie doch, oder?"

#: autoload/market_events.gd
msgid "My coins halved overnight. Gold doesn't do that, right?"
msgstr "Meine Coins haben sich über Nacht halbiert. Das macht Gold nicht, oder?"

#: autoload/market_events.gd
msgid "My nephew says gold is a boomer rock. Buy these?"
msgstr "Mein Neffe sagt, Gold ist ein Boomer-Stein. Kaufen Sie die?"

#: autoload/market_events.gd
msgid "My retirement account is red. Something safe, please."
msgstr "Mein Rentenkonto ist rot. Was Sicheres, bitte."

#: autoload/market_events.gd
msgid "NEWS: "
msgstr "NEWS: "

#: autoload/market_events.gd
msgid "Need cash fast, Bitcoin's taking off without me."
msgstr "Brauch schnell Bargeld, Bitcoin hebt ohne mich ab."

#: autoload/market_events.gd
msgid "PLATINUM POPS {move}. Owners rush to sell."
msgstr "PLATIN SCHIESST HOCH {move}. Besitzer eilen zum Verkauf."

#: autoload/market_events.gd
msgid "Platinum's finally moving. Selling while it lasts."
msgstr "Platin bewegt sich endlich. Ich verkaufe, solange es geht."

#: autoload/market_events.gd
msgid "SILVER ON SALE: SILVER {move}. Bargain hunters line up."
msgstr "SILBER IM ANGEBOT: SILBER {move}. Schnäppchenjäger stehen Schlange."

#: autoload/market_events.gd
msgid "SILVER SQUEEZE: SILVER {move}. Stackers storm the shops."
msgstr "SILBER-SQUEEZE: SILBER {move}. Stapler stürmen die Läden."

#: autoload/market_events.gd
msgid "STOCKS RALLY: S&P 500 {move}. Metal holders sell to buy shares."
msgstr "AKTIEN STEIGEN: S&P 500 {move}. Metallbesitzer verkaufen für Aktien."

#: autoload/market_events.gd
msgid "STOCKS TUMBLE: S&P 500 {move}. Investors run to safe-haven gold."
msgstr "AKTIEN FALLEN: S&P 500 {move}. Anleger flüchten in sicheres Gold."

#: autoload/market_events.gd
msgid "Saw it on the news. I'm getting out now."
msgstr "Hab's in den Nachrichten gesehen. Ich steig jetzt aus."

#: autoload/market_events.gd
msgid "Silver's going to the moon. I need tubes, now."
msgstr "Silber geht zum Mond. Ich brauch Tubes, sofort."

